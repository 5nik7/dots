# dots:summary=Print native shell initialization or explicitly set up files
# dots:usage=[bash|zsh|fish|powershell|nu|xonsh] | --bootstrap bash|zsh|powershell | --setup [OPTIONS]
# dots:option=--verbose|-v|flag|Show setup actions and backups
# dots:option=--bootstrap||choice:bash,zsh,powershell|Print standalone missing-checkout startup bootstrap
# dots:option=--setup||flag|Install platform configurations with retained backups
# dots:option=--dry-run||flag|Preview setup without writes
# dots:option=--yes||flag|Approve setup without prompting
# dots:option=--json||flag|Emit setup JSON
# dots:option=--update||flag|Update clean sources before setup
# dots:option=--with-source||choice:termux,windows,nvim|Select a bundled platform source or initialize nvim
# dots:option=--packages||file|Restore a package manifest during explicit setup
# dots:argument=1|choice:bash,zsh,fish,powershell,nu,xonsh|Shell adapter (default: Bash/Zsh)
# dots:example=eval "$(dots init)"
# dots:example=dots init fish | source
# dots:option=--interactive||flag|Open the setup wizard
# dots:option=--non-interactive||flag|Skip the wizard; writes require --yes
# dots:option=--component||choice:core,files,themes,anodize,blastoff,pkgs,packages,fonts,leaf|Select components instead of defaults; repeat
# dots:option=--resource||file-resource|Select enabled catalog IDs within Files; repeat
# dots:option=--no-clear||flag|Retain the visible screen on wizard entry
# dots:option=--no-logo||flag|Omit the wizard logo
# dots:option=--with-dependencies||flag|Offer mapped missing prerequisites before preparation
# dots:option=--save-choices||flag|Save successful choices in the active profile
# dots:option=--fonts||file|Restore exact font preferences
# dots:option=--font-target||choice:termux,kitty,wezterm,windows-terminal,vscode-editor,vscode-terminal|Select saved font targets; repeat
