# No catalog is read until Fish requests completion.
function __dots_complete_fish
    set -l words (commandline -opc)
    set -l current (commandline -ct)
    set -a words "$current"
    set -l cursor (math (count $words) - 1)
    for record in (command dots __complete fish $cursor -- $words 2>/dev/null)
        set -l fields (string split \t -- "$record")
        switch "$fields[1]"
            case candidate
                printf '%s\t%s\n' "$fields[2]" "$fields[3]"
            case file directory
                set -l prefix (string sub -s (math (string length -- "$fields[2]") + 1) -- "$current")
                set -l values
                if test "$fields[1]" = directory
                    set values (__fish_complete_directories "$prefix")
                else
                    set values (__fish_complete_path "$prefix")
                end
                # Helper output may contain descriptions separated by a tab.
                for value in $values
                    printf '%s%s\n' "$fields[2]" "$value"
                end
        end
    end
end
for name in dots theme todo fonts
    complete -c $name -f -a '(__dots_complete_fish)'
end
set -l theme_state "$HOME/.local/state"
if set -q XDG_STATE_HOME; and test -n "$XDG_STATE_HOME"
    set theme_state "$XDG_STATE_HOME"
end
set -l names_file "$theme_state/dots/themes/commands/current/names"
set -l next
if test -f "$names_file"; and not test -L "$names_file"
    while read -l name
        if string match -qr '^[a-z][a-z0-9_]*(?:-[a-z0-9_]+)*$' -- "$name"
            set -a next "$name"
        end
    end < "$names_file"
end
for name in $_DOTS_THEME_COMPLETION_NAMES
    if not contains -- "$name" $next
        # Fish erases all positional providers together. Preserve mixed entries;
        # the shared reader returns no palette candidates for a retired name.
        if not complete -c "$name" | string match -qvr -- '__dots_complete_fish'
            complete -e -c "$name"
        end
    end
end
for name in $next
    if not complete -c "$name" | string match -qvr -- '__dots_complete_fish'
        complete -c "$name" -f -a '(__dots_complete_fish)'
    end
end
set -g _DOTS_THEME_COMPLETION_NAMES $next
