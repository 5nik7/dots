# No catalog is read until Fish requests completion.
function __dots_complete_fish
    set -l words (commandline -opc)
    set -l current (commandline -ct)
    set -a words "$current"
    set -l key_position 0
    set -l route $words[2..-2]
    while test (count $route) -gt 0; and string match -qr '^--(color|icons)=' -- "$route[1]"
        set -e route[1]
    end
    if test "$words[1]" = dots; and test (count $route) -ge 2; and test "$route[1]" = config; and contains -- "$route[2]" get set unset explain
        set key_position 1
        set -l option_value 0
        for token in $route[3..-1]
            if test $option_value -eq 1
                set option_value 0
            else if contains -- "$token" --profile --app
                set option_value 1
            else if not string match -q -- '--*' "$token"
                set key_position 0
            end
        end
        if test $option_value -eq 1
            set key_position 0
        end
    end
    # Fish matches against the token captured before this callback. Queue one
    # native completion after consuming .., retaining its provider mode only for
    # that retry. This changes the edit buffer, never executes the command.
    if set -q __dots_config_branch_retry
        if test $key_position -eq 1
            set words[-1] "$__dots_config_branch_retry"
        end
        set -e __dots_config_branch_retry
    else if status is-interactive; and test $key_position -eq 1; and string match -q '*..' -- "$current"
        set -g __dots_config_branch_retry "$current"
        commandline --current-token --replace -- (string replace -r '\.\.$' '' -- "$current")
        commandline --function complete
        return
    end
    set -l cursor (math (count $words) - 1)
    for record in (command dots __complete fish $cursor -- $words 2>/dev/null)
        set -l fields (string split \t -- "$record")
        switch "$fields[1]"
            case candidate
                printf '%s\t%s\n' "$fields[2]" "$fields[3]"
            case file directory
                set -l prefix (string sub -s (math (string length -- "$fields[2]") + 1) -- "$current")
                set -l values
                if test "$fields[1]" = directory
                    set values (__fish_complete_directories "$prefix")
                else
                    set values (__fish_complete_path "$prefix")
                end
                # Helper output may contain descriptions separated by a tab.
                for value in $values
                    printf '%s%s\n' "$fields[2]" "$value"
                end
        end
    end
end
for name in dots theme todo fonts bak dots-bak linked lnkd cpwd pathout dirout isdir isfile fzcmd fzenv fzfd fzfig fzg fzopt fzpyfig fzrg fzrg3 cht httpGet www
    complete -c $name -f -a '(__dots_complete_fish)'
end
set -l theme_state "$HOME/.local/state"
if set -q XDG_STATE_HOME; and test -n "$XDG_STATE_HOME"
    set theme_state "$XDG_STATE_HOME"
end
set -l names_file "$theme_state/dots/themes/commands/current/names"
set -l next
if test -f "$names_file"; and not test -L "$names_file"
    while read -l name
        if string match -qr '^[a-z][a-z0-9_]*(?:-[a-z0-9_]+)*$' -- "$name"
            set -a next "$name"
        end
    end < "$names_file"
end
for name in $_DOTS_THEME_COMPLETION_NAMES
    if not contains -- "$name" $next
        # Fish erases all positional providers together. Preserve mixed entries;
        # the shared reader returns no palette candidates for a retired name.
        if not complete -c "$name" | string match -qvr -- '__dots_complete_fish'
            complete -e -c "$name"
        end
    end
end
for name in $next
    if not complete -c "$name" | string match -qvr -- '__dots_complete_fish'
        complete -c "$name" -f -a '(__dots_complete_fish)'
    end
end
set -g _DOTS_THEME_COMPLETION_NAMES $next
