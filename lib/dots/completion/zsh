#compdef dots
# Works both as an autoloaded _dots function and when explicitly sourced.
_dots() {
  local record kind value description display lead role
  local -i width=0 i config_branch=0
  local -a records candidates descriptions prefixes prefix_descriptions input_words candidate_types prefix_types typed
  if (( ${+functions[_dots_completion_role]} )); then
    _dots_completion_refresh
    typed=(--display-types)
  fi
  input_words=("${(@Q)words}")
  # ZLE's PREFIX ends at the cursor, while words may include a suffix after it.
  if [[ -n ${compstate[context]:-} ]]; then input_words[CURRENT]=$PREFIX; fi
  records=("${(@f)$(command dots __complete zsh "$((CURRENT-1))" "${typed[@]}" -- "${input_words[@]}" 2>/dev/null)}")
  for record in "${records[@]}"; do
    kind=${record%%$'\t'*}; record=${record#*$'\t'}
    value=${record%%$'\t'*}; description=${record#*$'\t'}
    role=candidate
    if [[ -n $typed && $description == *$'\t'* ]]; then
      role=${description##*$'\t'}; description=${description%$'\t'*}
      [[ $role == (command|option|value) ]] || role=candidate
    fi
    case $kind in
      candidate)
        [[ ${input_words[CURRENT]} != *.. || $description != Branch ]] || config_branch=1
        if [[ -n $description ]] && (( ${#value} > width )); then width=${#value}; fi
        if [[ $value == (*=|*.|*\[) ]]; then
          prefixes+=("$value"); prefix_descriptions+=("$description")
          prefix_types+=("$role")
        else
          candidates+=("$value"); descriptions+=("$description")
          candidate_types+=("$role")
        fi ;;
      file|directory)
        lead=$value
        if [[ -n $lead ]]; then compset -P "${(b)lead}"; fi
        if [[ $kind == directory ]]; then _files -/; else _files; fi ;;
    esac
  done
  # One display column across both ordinary matches and no-space prefixes.
  # compadd -d replaces the visible match; insertion still uses the raw arrays.
  for (( i=1; i<=${#candidates}; i++ )); do
    display=${candidates[i]}
    [[ -z ${descriptions[i]} ]] || printf -v display '%-*s -- %s' "$width" "$display" "${descriptions[i]}"
    descriptions[i]=$display
  done
  for (( i=1; i<=${#prefixes}; i++ )); do
    display=${prefixes[i]}
    [[ -z ${prefix_descriptions[i]} ]] || printf -v display '%-*s -- %s' "$width" "$display" "${prefix_descriptions[i]}"
    prefix_descriptions[i]=$display
  done
  if [[ -n $typed && ${_DOTS_COMPLETION_ENABLED:-1} == 1 ]]; then
    local -a matches labels
    local _DOTS_COMPLETION_TYPE
    # Native group names and fzf-tab headings carry types without coloring the
    # provider protocol or inserting descriptions into the command line.
    for _DOTS_COMPLETION_TYPE in command option value candidate; do
      matches=() labels=()
      for (( i=1; i<=${#candidates}; i++ )); do
        [[ ${candidate_types[i]} != $_DOTS_COMPLETION_TYPE ]] || { matches+=("${candidates[i]}"); labels+=("${descriptions[i]}"); }
      done
      (( ! ${#matches} )) || compadd -U -J "${_DOTS_COMPLETION_TYPE}s" -X "${(C)_DOTS_COMPLETION_TYPE}s" -d labels -a matches
      matches=() labels=()
      for (( i=1; i<=${#prefixes}; i++ )); do
        [[ ${prefix_types[i]} != $_DOTS_COMPLETION_TYPE ]] || { matches+=("${prefixes[i]}"); labels+=("${prefix_descriptions[i]}"); }
      done
      (( ! ${#matches} )) || compadd -U -S '' -J "${_DOTS_COMPLETION_TYPE}s" -X "${(C)_DOTS_COMPLETION_TYPE}s" -d labels -a matches
    done
  else
    (( ${#candidates} )) && compadd -U -d descriptions -a candidates
    (( ${#prefixes} )) && compadd -U -S '' -d prefix_descriptions -a prefixes
  fi
  # Consuming .. can shorten the common prefix. Show the branch choices now,
  # instead of spending the first Tab merely replacing .. with that prefix.
  (( ! config_branch )) || compstate[list]=force
  return 0
}
if [[ $ZSH_EVAL_CONTEXT == *:file ]]; then
  if (( ${+functions[compdef]} )); then
    compdef _dots dots theme todo fonts bak dots-bak
    if (( ! ${+functions[_dots_theme_completion_load]} )); then
      source "${${(%):-%x}:h}/theme.bash"
    fi
    _dots_theme_completion_load "${XDG_STATE_HOME:-$HOME/.local/state}/dots/themes/commands/current"
  fi
else
  _dots "$@"
fi
