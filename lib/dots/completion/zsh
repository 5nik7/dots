#compdef dots
# Works both as an autoloaded _dots function and when explicitly sourced.
_dots() {
  local record kind value description lead
  local -a records candidates descriptions prefixes prefix_descriptions input_words
  input_words=("${(@Q)words}")
  # ZLE's PREFIX ends at the cursor, while words may include a suffix after it.
  if [[ -n ${compstate[context]:-} ]]; then input_words[CURRENT]=$PREFIX; fi
  records=("${(@f)$(command dots __complete zsh "$((CURRENT-1))" -- "${input_words[@]}" 2>/dev/null)}")
  for record in "${records[@]}"; do
    kind=${record%%$'\t'*}; record=${record#*$'\t'}
    value=${record%%$'\t'*}; description=${record#*$'\t'}
    case $kind in
      candidate)
        if [[ $value == *= ]]; then
          prefixes+=("$value"); prefix_descriptions+=("${description:-$value}")
        else
          candidates+=("$value"); descriptions+=("${description:-$value}")
        fi ;;
      file|directory)
        lead=$value
        if [[ -n $lead ]]; then compset -P "${(b)lead}"; fi
        if [[ $kind == directory ]]; then _files -/; else _files; fi ;;
    esac
  done
  (( ${#candidates} )) && compadd -d descriptions -a candidates
  (( ${#prefixes} )) && compadd -S '' -d prefix_descriptions -a prefixes
  return 0
}
if [[ $ZSH_EVAL_CONTEXT == *:file ]]; then
  (( ${+functions[compdef]} )) && compdef _dots dots
else
  _dots "$@"
fi
