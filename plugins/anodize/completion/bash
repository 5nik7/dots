# shellcheck shell=bash
# Bash 4.4+ completion; loading this file does no discovery or subprocess work.
# Decode literal quoting up to the cursor, without evaluating substitutions.
_anodize_bash_words() {
  local input=${COMP_LINE:0:COMP_POINT} char next token='' quote='' started=0 i
  words=()
  for ((i=0; i<${#input}; i++)); do
    char=${input:i:1}
    if [[ $quote == "'" ]]; then
      if [[ $char == "'" ]]; then quote=''; else token+=$char; fi
    elif [[ $char == $'\\' && $quote != "'" ]]; then
      next=${input:i+1:1}
      if [[ -z $quote || $next == $'\\' || $next == '"' || $next == '$' || $next == '`' ]]; then
        token+=$next; (( ++i ))
      else token+=$char; fi
      started=1
    elif [[ $quote == '"' ]]; then
      if [[ $char == '"' ]]; then quote=''; else token+=$char; fi
    else
      case $char in
        "'"|'"') quote=$char; started=1 ;;
        ' '|$'\t'|$'\n')
          if (( started )); then words+=("$token"); token=''; started=0; fi ;;
        ';'|'|'|'&') words=(); token=''; started=0 ;;
        *) token+=$char; started=1 ;;
      esac
    fi
  done
  words+=("$token")
  ANODIZE_BASH_QUOTE=$quote
}
_anodize_bash_quote() {
  local value=$1
  case ${ANODIZE_BASH_QUOTE:-} in
    '"')
      value=${value//\\/\\\\}; value=${value//\"/\\\"}
      value=${value//\$/\\\$}; value=${value//\`/\\\`}
      REPLY=$value ;;
    "'") REPLY=${value//\'/\'\\\'\'} ;;
    *) printf -v REPLY '%q' "$value" ;;
  esac
}
_anodize_complete_bash() {
  local kind value _description item i trim='' prefix ANODIZE_BASH_QUOTE='' REPLY
  local -a words=() replies=()
  if [[ -n ${COMP_LINE+x} ]]; then
    _anodize_bash_words
    # Readline replaces only the value portion when '=' is a word break.
    if [[ ${words[-1]} == --*=* && ${COMP_WORDS[COMP_CWORD]} != --* ]]; then
      trim=${words[-1]%%=*}=
    fi
  else
    # Bash may split --option=value at '='. Rejoin only that literal boundary.
    for ((i=0; i<=COMP_CWORD; i++)); do
      item=${COMP_WORDS[i]}
      if [[ $item == = && ${#words[@]} -gt 0 && ${words[-1]} == --* ]]; then
        words[-1]+='='
        (( i != COMP_CWORD )) || trim=${words[-1]}
      elif [[ ${#words[@]} -gt 0 && ${words[-1]} == --*= ]]; then
        (( i != COMP_CWORD )) || trim=${words[-1]}
        words[-1]+=$item
      else words+=("$item"); fi
    done
  fi
  COMPREPLY=()
  while IFS=$'\t' read -r kind value _description; do
    case $kind in
      candidate)
        _anodize_bash_quote "${value#"$trim"}"
        COMPREPLY+=("$REPLY")
        compopt -o noquote 2>/dev/null || :
        [[ $value != *= ]] || compopt -o nospace 2>/dev/null || : ;;
      file|directory)
        prefix=${words[-1]#"$value"}
        replies=()
        if [[ $kind == directory ]]; then mapfile -t replies < <(compgen -d -- "$prefix")
        else mapfile -t replies < <(compgen -f -- "$prefix"); fi
        for item in "${replies[@]}"; do COMPREPLY+=("${value#"$trim"}$item"); done
        compopt -o filenames 2>/dev/null || : ;;
    esac
  done < <(command anodize __complete bash "$((${#words[@]}-1))" -- "${words[@]}" 2>/dev/null)
}
complete -F _anodize_complete_bash anodize
