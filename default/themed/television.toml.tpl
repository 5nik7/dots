# Dots semantic theme. Structure adapted from Television's Catppuccin theme:
# https://github.com/alexpasmantier/television/blob/main/themes/catppuccin.toml
# General
background = '{{ background }}'
border_fg = '{{ lighter_background }}'
text_fg = '{{ foreground }}'
dimmed_text_fg = '{{ muted }}'
# Input
input_text_fg = '{{ accent }}'
result_count_fg = '{{ muted }}'
# Results
result_name_fg = '{{ blue }}'
result_line_number_fg = '{{ light_foreground }}'
result_value_fg = '{{ bright_blue }}'
selection_fg = '{{ accent }}'
selection_bg = '{{ lighter_background }}'
match_fg = '{{ green }}'
# Preview
preview_title_fg = '{{ orange }}'
# Modes
channel_mode_fg = '{{ darker_background }}'
channel_mode_bg = '{{ magenta }}'
remote_control_mode_fg = '{{ background }}'
remote_control_mode_bg = '{{ green }}'
action_picker_mode_fg = '{{ background }}'
action_picker_mode_bg = '{{ blue }}'
