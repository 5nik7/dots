set -g status-style "bg=#{?#{!=:#{TERMUX_VERSION},},#{@dots-termux-lower-bg},default},fg={{ tmux_ui_foreground_fg }}"
set -g @dots-termux-bg "{{ background }}"
set -g @dots-termux-fg "{{ tmux_ui_foreground_fg }}"
set -g @dots-termux-inactive-bg "{{ dark_background }}"
set -g @dots-termux-inactive-fg "{{ dark_foreground }}"
set -g @dots-termux-current-bg "{{ tmux_ui_selection_bg }}"
set -g @dots-termux-current-fg "{{ bright_cyan }}"
set -g @dots-termux-tab-current-fg "{{ bright_foreground }}"
set -g pane-border-style "fg={{ tmux_pane_inactive_border_fg }}"
set -g pane-active-border-style "fg={{ tmux_pane_active_border_fg }}"
set -g message-style "bg=default,fg={{ tmux_ui_foreground_fg }}"
set -g mode-style "bg={{ selection }},fg={{ tmux_ui_foreground_fg }}"
set -g popup-style "bg={{ background }},fg={{ tmux_ui_foreground_fg }}"
set -g popup-border-style "fg={{ tmux_ui_border_fg }},bg={{ background }}"
set -g @dots-indicator-fg "{{ darker_background }}"
set -g @dots-indicator-bg "{{ green }}"
set -g @dots-prefix-fg "{{ tmux_ui_accent_fg }}"
set -g @dots-prefix-bg "{{ dark_background }}"
set -g message-command-style "bg=default,fg={{ tmux_ui_accent_fg }}"
setw -g clock-mode-colour "{{ tmux_ui_muted_fg }}"
set -g @dots-termux-lower-bg "{{ background }}"
set -g @dots-termux-window-bg "{{ tmux_window_inactive_bg }}"
set -g @dots-termux-window-fg "{{ tmux_window_inactive_fg }}"
set -g @dots-termux-selected-bg "{{ tmux_window_active_bg }}"
set -g @dots-window-selected-fg "{{ tmux_window_active_fg }}"
set -g @dots-window-name-current-fg "{{ bright_foreground }}"
set -g @dots-window-name-current-bg "{{ tmux_window_active_bg }}"
set -g @dots-window-name-inactive-fg "{{ dark_foreground }}"
set -g @dots-window-name-codex-fg "{{ tmux_ui_foreground_fg }}"
set -g @dots-window-number-inactive-fg "{{ dark_foreground }}"
set -g @dots-window-number-codex-fg "{{ dark_foreground }}"
set -g @dots-window-codex-fg "{{ tmux_ui_accent_fg }}"
set -g @dots-window-codex-working-fg "{{ tmux_ui_accent_fg }}"
set -g @dots-window-alert-fg "{{ tmux_window_attention_fg }}"
set -g @dots-window-alert-bg "{{ tmux_window_attention_bg }}"
set -g @dots-separator-fg "{{ tmux_ui_separator_fg }}"
set -g @dots-separator-bg "{{ dark_background }}"
set -g @dots-label-separator-fg "{{ dark_background }}"
set -g @dots-termux-clock-bg "{{ dark_background }}"
set -g @dots-termux-clock-fg "{{ tmux_ui_foreground_fg }}"
set -g @dots-termux-muted "{{ tmux_ui_muted_fg }}"
set -g @dots-termux-hint "{{ tmux_ui_heading_fg }}"
set -g @dots-termux-red "{{ red }}"
set -g @dots-termux-yellow "{{ yellow }}"
set -g @dots-termux-green "{{ green }}"
set -g @dots-termux-blue "{{ blue }}"
set -g @dots-gitmux-branch "{{ git_branch }}"
set -g @dots-gitmux-staged "{{ git_staged }}"
set -g @dots-gitmux-modified "{{ git_modified }}"
set -g @dots-gitmux-untracked "{{ git_untracked }}"
set -g @dots-gitmux-conflict "{{ git_conflict }}"
set -g @dots-gitmux-clean "{{ git_clean }}"
set -g @dots-gitmux-added "{{ git_added }}"
set -g @dots-gitmux-deleted "{{ git_deleted }}"
set -g @dots-gitmux-ahead "{{ git_ahead }}"
set -g @dots-gitmux-behind "{{ git_behind }}"
set -g @dots-gitmux-warning "{{ tmux_status_warning_fg }}"
set -g @dots-gitmux-stash "{{ cyan }}"
set -g @dots-gitmux-muted "{{ tmux_ui_muted_fg }}"

# Literal shared activity symbols; expanded only as tmux option values.
set -g @dots-icon-status-working {{ tmux_icon_status_working }}
set -g @dots-icon-status-waiting {{ tmux_icon_status_waiting }}
set -g @dots-icon-navigation-codex {{ tmux_icon_navigation_codex }}
set -g @dots-icon-navigation-separator {{ tmux_icon_navigation_separator }}
set -g @dots-window-inactive-fg "{{ tmux_window_inactive_fg }}"
set -g @dots-window-inactive-bg "{{ tmux_window_inactive_bg }}"
set -g @dots-status-separator '#[fg=#{@dots-separator-fg},bg=#{@dots-separator-bg},nobold,nounderscore,noreverse,nodim]#{@dots-icon-navigation-separator}#[default]'
