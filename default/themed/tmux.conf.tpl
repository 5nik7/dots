set -g status-style "bg=#{?#{!=:#{TERMUX_VERSION},},#{@dots-termux-lower-bg},default},fg={{ foreground }}"
set -g @dots-termux-bg "{{ background }}"
set -g @dots-termux-fg "{{ foreground }}"
set -g @dots-termux-inactive-bg "{{ dark_background }}"
set -g @dots-termux-inactive-fg "{{ dark_foreground }}"
set -g @dots-termux-current-bg "{{ selection_background }}"
set -g @dots-termux-current-fg "{{ bright_cyan }}"
set -g @dots-termux-tab-current-fg "{{ orange }}"
set -g pane-border-style "fg={{ muted }}"
set -g pane-active-border-style "fg={{ selection }}"
set -g message-style "bg=default,fg={{ foreground }}"
set -g mode-style "bg={{ selection }},fg={{ foreground }}"
set -g popup-style "bg={{ background }},fg={{ foreground }}"
set -g popup-border-style "fg={{ lighter_background }},bg={{ background }}"
set -g @dots-indicator-fg "{{ darker_background }}"
set -g @dots-indicator-bg "{{ green }}"
set -g @dots-prefix-fg "{{ accent }}"
set -g @dots-prefix-bg "{{ dark_background }}"
set -g message-command-style "bg=default,fg={{ accent }}"
setw -g clock-mode-colour "{{ muted }}"
set -g @dots-termux-lower-bg "{{ background }}"
set -g @dots-termux-window-bg "{{ dark_background }}"
set -g @dots-termux-window-fg "{{ light_foreground }}"
set -g @dots-termux-selected-bg "{{ selection_background }}"
set -g @dots-window-selected-fg "{{ bright_green }}"
set -g @dots-window-name-current-fg "{{ bright_foreground }}"
set -g @dots-window-name-current-bg "{{ selection_background }}"
set -g @dots-window-name-inactive-fg "{{ dark_foreground }}"
set -g @dots-window-name-codex-fg "{{ foreground }}"
set -g @dots-window-number-inactive-fg "{{ dark_foreground }}"
set -g @dots-window-number-codex-fg "{{ magenta }}"
set -g @dots-window-codex-fg "{{ accent }}"
set -g @dots-window-codex-working-fg "{{ accent }}"
set -g @dots-window-alert-fg "{{ bright_red }}"
set -g @dots-window-alert-bg "{{ darker_background }}"
set -g @dots-separator-fg "{{ background }}"
set -g @dots-separator-bg "{{ dark_background }}"
set -g @dots-label-separator-fg "{{ dark_background }}"
set -g @dots-termux-clock-bg "{{ dark_background }}"
set -g @dots-termux-clock-fg "{{ foreground }}"
set -g @dots-termux-muted "{{ muted }}"
set -g @dots-termux-hint "{{ hint }}"
set -g @dots-termux-red "{{ red }}"
set -g @dots-termux-yellow "{{ yellow }}"
set -g @dots-termux-green "{{ green }}"
set -g @dots-termux-blue "{{ blue }}"
set -g @dots-gitmux-branch "{{ git_branch }}"
set -g @dots-gitmux-staged "{{ git_staged }}"
set -g @dots-gitmux-modified "{{ git_modified }}"
set -g @dots-gitmux-untracked "{{ git_untracked }}"
set -g @dots-gitmux-conflict "{{ git_conflict }}"
set -g @dots-gitmux-clean "{{ git_clean }}"
set -g @dots-gitmux-added "{{ git_added }}"
set -g @dots-gitmux-deleted "{{ git_deleted }}"
set -g @dots-gitmux-ahead "{{ git_ahead }}"
set -g @dots-gitmux-behind "{{ git_behind }}"
set -g @dots-gitmux-warning "{{ warning }}"
set -g @dots-gitmux-stash "{{ cyan }}"
set -g @dots-gitmux-muted "{{ muted }}"
