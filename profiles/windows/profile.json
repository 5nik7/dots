      "category": "config",
      "target": "${APP_CONFIG:clink}/fzf.lua",
      "strategy": "link"
    },
    {
      "id": "bat",
      "source": "${DOTS}/config/bat",
      "app": "bat",
      "category": "config",
      "target": "${APP_CONFIG:bat}",
      "strategy": "directory-link",
      "replaces": [
        "termux:bat"
      ]
    },
    {
      "id": "blastoff",
      "source": "${DOTS}/config/blastoff",
      "target": "${HOME}/.config/blastoff",
      "strategy": "directory-link",
      "app": "blastoff",
      "category": "config"
    },
    {
      "id": "gemrc",
      "source": "${DOTS}/config/ruby/gemrc",
      "target": "${HOME}/.gemrc",
      "strategy": "link",
      "app": "ruby",
      "category": "shell"
    },
    {
      "id": "git",
      "source": "${DOTS}/config/git",
      "app": "git",
      "category": "config",
      "target": "${CONFIG}/git",
      "strategy": "directory-link"
    },
    {
      "id": "irbrc",
      "source": "${DOTS}/config/ruby/irbrc",
      "target": "${HOME}/.irbrc",
      "strategy": "link",
      "app": "ruby",
      "category": "shell"
    },
