      "source": "${PROFILE}/config/clink/starship.lua",
      "app": "clink",
      "category": "config",
      "target": "${APP_CONFIG:clink}/starship.lua",
      "strategy": "link"
    },
    {
      "id": "clink-scoop",
      "source": "${PROFILE}/config/clink/scoop.lua",
      "app": "clink",
