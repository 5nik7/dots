      "target": "${HOME}/.codex/skills/dots-todo-planning",
      "strategy": "directory-link",
      "app": "codex",
      "category": "skill"
    },
    {
      "id": "todo-maintenance-skill",
      "source": "${DOTS}/.codex/skills/dots-todo-maintenance",
      "target": "${HOME}/.codex/skills/dots-todo-maintenance",
      "strategy": "directory-link",
      "app": "codex",
      "category": "skill"
