      "category": "theme",
      "strategy": "link"
    },
    {
      "id": "codex",
      "source": "${THEME}/bat.tmTheme",
      "target": "${APP_CONFIG:codex}/themes/dots.tmTheme",
      "app": "codex",
      "category": "theme",
      "strategy": "link"
    },
    {
      "id": "claude-code",
      "source": "${THEME}/claude-code.json",
      "target": "${APP_CONFIG:claude-code}/themes/dots.json",
      "app": "claude-code",
      "category": "theme",
      "strategy": "link"
    },
    {
      "id": "pi",
      "source": "${THEME}/pi.json",
      "target": "${APP_CONFIG:pi}/themes/dots.json",
      "app": "pi",
      "category": "theme",
      "strategy": "link"
    }
