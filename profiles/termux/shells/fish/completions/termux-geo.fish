# Generated by termux-geo; static completion, no device or network queries.
function __termux_geo_template
    set -l fragment (commandline -ct)
    set fragment (string replace -r '^--format=' '' -- "$fragment")
    set -l lead ''
    if string match -q '*{*' -- "$fragment"
        set lead (string replace -r '\{[^{}]*$' '' -- "$fragment")
        set fragment (string replace -r '^.*\{' '' -- "$fragment")
    end
    for field in latitude longitude coordinates accuracy_m city state state_code postcode county country country_code street house_number address source provider age_seconds cached address_cached stale attribution lat lon zip
        if string match -q -- "$fragment*" "$field"
            printf '%s{%s}\n' "$lead" "$field"
        end
    end
end
complete -c termux-geo -f
complete -c termux-geo -n 'not __fish_seen_subcommand_from show get format completion' -a 'show get format completion'
complete -c termux-geo -n '__fish_seen_subcommand_from get' -a 'latitude longitude coordinates accuracy_m city state state_code postcode county country country_code street house_number address source provider age_seconds cached address_cached stale attribution lat lon zip'
complete -c termux-geo -n '__fish_seen_subcommand_from format' -a '(__termux_geo_template)'
complete -c termux-geo -n '__fish_seen_subcommand_from completion' -a 'bash zsh fish'
complete -c termux-geo -n '__fish_seen_subcommand_from completion' -l install -d 'Install completion files'
complete -c termux-geo -n '__fish_seen_subcommand_from completion' -l all -d 'Install all shells'
complete -c termux-geo -n '__fish_seen_subcommand_from completion' -l dir -r -a '(__fish_complete_directories)' -d 'Exact destination directory'
complete -c termux-geo -l help -s h -d 'Show help'
complete -c termux-geo -l verbose -s v -d 'Human operational details'
complete -c termux-geo -l color -x -a 'auto always never' -d 'Color mode'
complete -c termux-geo -l icons -x -a 'auto always never' -d 'Icon mode'
complete -c termux-geo -n 'not __fish_seen_subcommand_from completion' -l get -s g -x -a 'latitude longitude coordinates accuracy_m city state state_code postcode county country country_code street house_number address source provider age_seconds cached address_cached stale attribution lat lon zip' -d 'Print a field'
complete -c termux-geo -n 'not __fish_seen_subcommand_from completion' -l format -s f -x -a '(__termux_geo_template)' -d 'Format fields'
complete -c termux-geo -n 'not __fish_seen_subcommand_from completion' -l provider -s p -x -a 'network gps passive' -d 'Device provider'
complete -c termux-geo -n 'not __fish_seen_subcommand_from completion' -l refresh -s r -d 'New device fix'
for option in lat lon max-age timeout language
    complete -c termux-geo -n 'not __fish_seen_subcommand_from completion' -l $option -x
end
for option in json human coords stdin cached allow-stale fields
    complete -c termux-geo -n 'not __fish_seen_subcommand_from completion' -l $option
end
