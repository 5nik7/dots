#compdef termux-geo
# Generated by termux-geo; static completion, no device or network queries.
_termux-geo() {
  local context state state_descr line
  local -a fields=(latitude longitude coordinates accuracy_m city state state_code postcode county country country_code street house_number address source provider age_seconds cached address_cached stale attribution lat lon zip)
  typeset -A opt_args
  if (( ${words[(Ie)completion]} )); then
    _arguments -s \
      '--install[Install completion files]' '--all[Install all three shells]' \
      '--dir[Exact installation directory]:directory:_files -/' \
      '(-v --verbose)'{-v,--verbose}'[Show details]' \
      '(-h --help)'{-h,--help}'[Show help]' \
      '--color[Color mode]:mode:(auto always never)' '--icons[Icon mode]:mode:(auto always never)' \
      '1:command:(completion)' '2:shell:(bash zsh fish)'
    return
  fi
  _arguments -s \
    '--json[Print JSON]' '--human[Print a human report]' '--coords[Print coordinates only]' \
    '(-g --get)'{-g,--get}'[Print a field]:field:->fields' \
    '(-f --format)'{-f,--format}'[Format fields]:template:->template' \
    '--lat[Input latitude]:latitude:' '--lon[Input longitude]:longitude:' '--stdin[Read location JSON]' \
    '(-p --provider)'{-p,--provider}'[Device provider]:provider:(network gps passive)' \
    '(-r --refresh)'{-r,--refresh}'[Obtain a new device fix]' '--cached[Use only cache]' \
    '--max-age[Maximum fix age]:seconds:' '--allow-stale[Allow expired cache]' \
    '--timeout[Overall deadline]:seconds:' '--language[Address language]:language:' \
    '--fields[List fields]' '(-v --verbose)'{-v,--verbose}'[Show details]' \
    '--color[Color mode]:mode:(auto always never)' '--icons[Icon mode]:mode:(auto always never)' \
    '(-h --help)'{-h,--help}'[Show help]' \
    '1:command:(show get format completion)' '2:argument:->argument'
  case $state in
    fields) _describe field fields ;;
    argument)
      case ${words[2]} in get) _describe field fields ;; format) state=template ;; esac ;;
  esac
  if [[ $state == template ]]; then
    local field fragment=${(Q)PREFIX} lead=''
    local -a values=()
    fragment=${fragment#--format=}
    if [[ $fragment == *\{* ]]; then lead=${fragment%\{*}; fragment=${fragment##*\{}; fi
    for field in $fields; do [[ $field != "$fragment"* ]] || values+=("$lead{$field}"); done
    compadd -U -- "${values[@]}"
  fi
}
_termux-geo "$@"
