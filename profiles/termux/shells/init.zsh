# Profile paths and maps are generated by the Dots backend.
# Select the Termux defaults before FZF and the final widget bindings.
zsh[profile_local]="$DOTS/profiles/termux/shells/zsh/local.zsh"
alias ".a"="cd $droid[root]"
alias ".ac"="cd $droid[configs]"
alias ".ab"="cd $droid[bin]"
alias ".as"="cd $droid[shells]"
alias ".asz"="cd $droid[zsh]"
alias ".v"="cd ${droid[configs]}/nvim"
