{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": null,
  "display": {
    "separator": "",
    "key": {
      "type": "both",
      "paddingLeft": 1,
      "width": 15,
    },
  },
  "modules": [
    {
      "keyColor": "green",
      "type": "host",
    },
    {
      "type": "cpu",
      "showPeCoreCount": true,
      "temp": true,
      "keyColor": "green",
    },
    {
      "keyColor": "yellow",
      "type": "memory",
    },
    {
      "keyColor": "yellow",
      "type": "swap",
    },
    {
      "type": "custom",
      "keyIcon": "",
      "key": "Disks",
    },
    {
      "type": "disk",
      "key": " ",
      "format": "        [{mountpoint}] - {size-used} / {size-total} ({size-percentage})",
    },
    {
      "type": "os",
      "keyColor": "cyan",
    },
    {
      "type": "kernel",
      "keyColor": "cyan",
    },
    {
      "type": "packages",
      "keyColor": "red",
      "key": "Pkgs",
    },
    {
      "type": "shell",
      "keyColor": "red",
    },
    {
      "type": "terminal",
      "key": "Term",
      "keyColor": "red",
    },
    {
      "type": "locale",
      "keyColor": "magenta",
    },
    {
      "type": "colors",
      "key": "Colors",
      "symbol": "circle",
    },
  ],
}
