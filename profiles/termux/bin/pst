#!/data/data/com.termux/files/usr/bin/sh
# Compatibility entry point; the shared command selects the native clipboard.
_clipboard_source=$0
case $_clipboard_source in /*) ;; *) _clipboard_source=$PWD/$_clipboard_source ;; esac
_clipboard_links=0
while [ -L "$_clipboard_source" ]; do
  _clipboard_links=$((_clipboard_links + 1))
  [ "$_clipboard_links" -le 40 ] || { printf 'pst: executable symlink loop\n' >&2; exit 1; }
  _clipboard_target=$(readlink -- "$_clipboard_source") || exit 1
  case $_clipboard_target in
    /*) _clipboard_source=$_clipboard_target ;;
    *) _clipboard_source=${_clipboard_source%/*}/$_clipboard_target ;;
  esac
done
_clipboard_root=$(CDPATH='' cd -- "${_clipboard_source%/*}/../../.." && pwd -P) || exit 1
exec bash "$_clipboard_root/scripts/pst" "$@"
