#!/usr/bin/env bash
# Compatibility entry point; all mutation and recovery belongs to dots fonts.
if command -v fonts >/dev/null 2>&1; then
  exec fonts __legacy getnf "$@"
fi
if [[ -n ${DOTS:-} && -x $DOTS/bin/fonts ]]; then
  exec "$DOTS/bin/fonts" __legacy getnf "$@"
fi
printf 'getnf: Dots fonts is unavailable; add the Dots bin directory to PATH.\n' >&2
exit 1
