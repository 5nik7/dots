#!/data/data/com.termux/files/usr/bin/env bash
# chnf - Change Termux font using fonts already installed by termux-nf/getnf.

set -uo pipefail

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
dist_dir="${TERMUX_NF_FONT_DIR:-$PREFIX/share/termux-nf/fonts}"
termux_dir="$HOME/.termux"
termux_font="$termux_dir/font.ttf"

# Reload by default. Use --no-reload if you only want to copy ~/.termux/font.ttf.
reload_after_apply='True'

# Colors, with a safe fallback for non-interactive shells.
if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ $(tput colors 2>/dev/null || echo 0) -ge 8 ]]; then
  RED=$(tput setaf 1)
  GREEN=$(tput setaf 2)
  BLUE=$(tput setaf 4)
  CYAN=$(tput setaf 6)
  BOLD=$(tput bold)
  RESET=$(tput sgr0)
else
  RED=''
  GREEN=''
  BLUE=''
  CYAN=''
  BOLD=''
  RESET=''
fi

usage() {
  cat <<EOF_USAGE
chnf: change Termux font from already-installed termux-nf fonts

Usage:
  chnf                         browse installed fonts, apply selection, then reload
  chnf <font-query>            apply a matching font directly, then reload
  chnf -i <font-query>         apply a matching font directly, then reload
  chnf -r <font-query>         explicitly apply font and reload
  chnf --reload <font-query>   same as -r
  chnf --no-reload <query>     apply font without reloading active Termux sessions
  chnf -l                      list installed font files
  chnf -h                      show this help

Reload behavior:
  By default, chnf copies the selected font to ~/.termux/font.ttf and then
  reloads Termux settings using termux-reload-settings when available.

  If termux-reload-settings is not available, chnf falls back to the same
  broadcast style while respecting TERMUX__USER_ID instead of hardcoding user 0.

  Use --no-reload to only copy the font file.

Fonts are read from:
  $dist_dir

Examples:
  chnf
  chnf -l
  chnf JetBrainsMono
  chnf --reload JetBrainsMono
  chnf --no-reload JetBrainsMono
  chnf "MesloLGS NF Regular.ttf"
  chnf "JetBrainsMono/JetBrainsMonoNerdFont-Regular.ttf"

Override font directory:
  TERMUX_NF_FONT_DIR=/path/to/fonts chnf
EOF_USAGE
}

info() {
  printf '%b\n' "$*"
}

confirm() {
  printf '%b\n' "${GREEN}$*${RESET}"
}

alert() {
  printf '%b\n' "${RED}$*${RESET}" >&2
}

die() {
  alert "$*"
  exit 1
}

relative_path() {
  local path=$1
  path=${path#"$dist_dir"/}
  printf '%s\n' "$path"
}

ensure_ready() {
  [[ -d $dist_dir ]] || die "Fonts directory not found: $dist_dir
Run getnf first, or set TERMUX_NF_FONT_DIR to your fonts directory."

  if ! find "$dist_dir" -type f -iname '*.ttf' -print -quit 2>/dev/null | grep -q .; then
    die "No .ttf files found under: $dist_dir
Install fonts with getnf first."
  fi
}

list_fonts() {
  (
    cd "$dist_dir" || exit 1
    find . -type f -iname '*.ttf' -print | sed 's#^\./##' | sort -f
  )
}

reload_termux() {
  local termux_user_id

  info "    ${BLUE}[${RED}*${BLUE}]${RESET} ${BLUE}Reloading Termux settings...${RESET}"

  # Prefer Termux's own helper because it handles TERMUX__USER_ID correctly.
  if command -v termux-reload-settings >/dev/null 2>&1; then
    if termux-reload-settings >/dev/null 2>&1; then
      confirm "    [*] Termux settings reload broadcast sent."
      return 0
    fi
  fi

  # Fallback copied from termux-reload-settings behavior.
  # Do not hardcode --user 0; use TERMUX__USER_ID when Termux provides it.
  case "${TERMUX__USER_ID:-}" in
    ''|*[!0-9]*|0[0-9]*) termux_user_id=0 ;;
    *) termux_user_id=$TERMUX__USER_ID ;;
  esac

  if command -v am >/dev/null 2>&1; then
    if am broadcast --user "$termux_user_id" -a "com.termux.app.reload_style" "com.termux" >/dev/null 2>&1; then
      confirm "    [*] Termux settings reload broadcast sent."
      return 0
    fi
  fi

  alert "Font copied, but automatic reload failed. Restart Termux to see the change."
  return 1
}

apply_font() {
  local font=$1

  [[ -f $font ]] || die "Not a file: $font"
  [[ ${font,,} == *.ttf ]] || die "Not a .ttf font: $font"

  mkdir -p "$termux_dir" || die "Failed to create: $termux_dir"
  cp -f "$font" "$termux_font" || die "Failed to apply font: $font"

  confirm "Font applied: $(relative_path "$font")"

  if [[ ${reload_after_apply:-True} == 'True' ]]; then
    reload_termux || true
  else
    info "Reload skipped. Open a new Termux session or run ${BOLD}termux-reload-settings${RESET} to see the font change."
  fi
}

collect_entries() {
  local dir=$1
  dirs=()
  fonts=()

  local item
  for item in "$dir"/*; do
    [[ -e $item ]] || continue
    if [[ -d $item ]]; then
      dirs+=("$item")
    elif [[ -f $item && ${item,,} == *.ttf ]]; then
      fonts+=("$item")
    fi
  done
}

browse_dir() {
  local dir=$1
  local choice idx entry_type entry_path
  local -a labels types paths

  while true; do
    collect_entries "$dir"
    labels=()
    types=()
    paths=()

    info ""
    info "${BOLD}${CYAN}Installed fonts:${RESET} $(relative_path "$dir")"

    if [[ $dir != "$dist_dir" ]]; then
      labels+=("../")
      types+=("back")
      paths+=("$(dirname "$dir")")
    fi

    local d f
    for d in "${dirs[@]}"; do
      labels+=("$(basename "$d")/")
      types+=("dir")
      paths+=("$d")
    done

    for f in "${fonts[@]}"; do
      labels+=("$(basename "$f")")
      types+=("font")
      paths+=("$f")
    done

    if ((${#labels[@]} == 0)); then
      alert "No folders or .ttf files here: $(relative_path "$dir")"
      [[ $dir == "$dist_dir" ]] && exit 1
      dir=$(dirname "$dir")
      continue
    fi

    for idx in "${!labels[@]}"; do
      printf '%b%3d%b) %s\n' "$BLUE" "$((idx + 1))" "$RESET" "${labels[$idx]}"
    done

    printf '%b' "${BLUE}Enter number, b to go back, or q to quit:${RESET} "
    IFS= read -r choice || exit 1

    case $choice in
      q|Q|quit|exit)
        confirm "Goodbye!"
        exit 0
        ;;
      b|B|back)
        [[ $dir != "$dist_dir" ]] && dir=$(dirname "$dir")
        continue
        ;;
    esac

    if [[ ! $choice =~ ^[0-9]+$ ]] || ((choice < 1 || choice > ${#labels[@]})); then
      alert "Invalid choice. Try again."
      continue
    fi

    idx=$((choice - 1))
    entry_type=${types[$idx]}
    entry_path=${paths[$idx]}

    case $entry_type in
      back|dir)
        dir=$entry_path
        ;;
      font)
        apply_font "$entry_path"
        return 0
        ;;
    esac
  done
}

choose_from_matches() {
  local -a matches=("$@")
  local choice idx font

  if ((${#matches[@]} == 1)); then
    apply_font "${matches[0]}"
    return
  fi

  info ""
  info "${BOLD}${CYAN}Multiple matches:${RESET}"
  for idx in "${!matches[@]}"; do
    printf '%b%3d%b) %s\n' "$BLUE" "$((idx + 1))" "$RESET" "$(relative_path "${matches[$idx]}")"
  done

  while true; do
    printf '%b' "${BLUE}Enter number or q to quit:${RESET} "
    IFS= read -r choice || exit 1

    case $choice in
      q|Q|quit|exit)
        confirm "Goodbye!"
        exit 0
        ;;
    esac

    if [[ $choice =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= ${#matches[@]})); then
      font=${matches[$((choice - 1))]}
      apply_font "$font"
      return
    fi

    alert "Invalid choice. Try again."
  done
}

apply_query() {
  local query=$1
  local q_lc=${query,,}
  local font rel base
  local -a exact_matches contains_matches

  # Direct relative path under dist_dir.
  if [[ -f $dist_dir/$query ]]; then
    apply_font "$dist_dir/$query"
    return
  fi

  # Direct directory under dist_dir. This keeps the same drill-down feel as getnf's termux() function.
  if [[ -d $dist_dir/$query ]]; then
    browse_dir "$dist_dir/$query"
    return
  fi

  while IFS= read -r -d '' font; do
    rel=$(relative_path "$font")
    base=$(basename "$font")

    if [[ $rel == "$query" || $base == "$query" ]]; then
      exact_matches+=("$font")
    elif [[ ${rel,,} == *"$q_lc"* || ${base,,} == *"$q_lc"* ]]; then
      contains_matches+=("$font")
    fi
  done < <(find "$dist_dir" -type f -iname '*.ttf' -print0 2>/dev/null)

  if ((${#exact_matches[@]} > 0)); then
    choose_from_matches "${exact_matches[@]}"
  elif ((${#contains_matches[@]} > 0)); then
    choose_from_matches "${contains_matches[@]}"
  else
    die "No installed font matched: $query"
  fi
}

main() {
  local direct_query=''
  local list_only='False'

  while (($#)); do
    case $1 in
      -h|--help|help)
        usage
        exit 0
        ;;
      -l|--list)
        list_only='True'
        ;;
      -r|--reload)
        reload_after_apply='True'
        ;;
      --no-reload)
        reload_after_apply='False'
        ;;
      -i|--font|--apply)
        shift
        [[ $# -gt 0 ]] || die "Option requires a font name or search query."
        [[ -z $direct_query ]] || die "Only one font query can be used at a time."
        direct_query=$1
        ;;
      --)
        shift
        [[ $# -gt 0 ]] && direct_query=$*
        break
        ;;
      -*)
        die "Unknown option: $1"
        ;;
      *)
        [[ -z $direct_query ]] || die "Only one font query can be used at a time."
        direct_query=$1
        ;;
    esac
    shift || true
  done

  ensure_ready

  if [[ $list_only == 'True' ]]; then
    list_fonts
  elif [[ -n $direct_query ]]; then
    apply_query "$direct_query"
  else
    browse_dir "$dist_dir"
  fi
}

main "$@"