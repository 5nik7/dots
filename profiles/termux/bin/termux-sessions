#!/data/data/com.termux/files/usr/bin/env python3
"""Report live terminal sessions belonging to the inherited Termux app process."""

import argparse
import json
import os
from pathlib import Path
import shlex
import stat
import string
import subprocess
import sys
import tempfile
import time
import unicodedata


FIELDS = {
    "current": "current session number (alias of number)",
    "number": "current session number in creation order",
    "previous": "previous session number, wrapping",
    "next": "next session number, wrapping",
    "total": "number of running sessions",
    "pid": "current session root process ID",
    "tty": "current session terminal",
    "command": "current session root process name",
    "first": "first session number",
    "last": "last session number",
}
SHELLS = ("bash", "zsh", "fish")
ALIASES = {"get": "--get", "format": "--format", "completion": "--completion"}
# Names, description, value kind, argument group. Completion generators use
# the same records as argparse so that options and candidates stay in sync.
OPTIONS = (
    (("--count",), "print the session count only", None, "mode"),
    (("--list",), "list PID, TTY, and root process name", None, "mode"),
    (("--json",), "print count and sessions as JSON", None, "mode"),
    (("-g", "--get"), "print one session field", "field", "mode"),
    (("-f", "--format"), "render a template with {field} placeholders", "template", "mode"),
    (("--fields",), "print available field names", None, "mode"),
    (("--completion",), "print shell completion source", "shell", "mode"),
    (("--pid",), "resolve context from this process or its ancestors", "pid", "selector"),
    (("--tty",), "select a Termux session by pts/N or /dev/pts/N", "tty", "selector"),
    (("--install",), "install completion files instead of printing source", None, "install"),
    (("--all",), "install completions for all three shells", None, "install"),
    (("--dir",), "install into this exact directory", "directory", "install"),
    (("-h", "--help"), "show this help message and exit", None, "help"),
)


class DiscoveryError(Exception):
    """A complete process snapshot could not be obtained."""


def parse_stat(text):
    # comm may contain spaces, parentheses, and newlines.
    opening = text.index("(")
    closing = text.rindex(")")
    pid = int(text[:opening].strip())
    fields = text[closing + 1 :].split()
    return {
        "pid": pid,
        "command": text[opening + 1 : closing],
        "state": fields[0],
        "ppid": int(fields[1]),
        "sid": int(fields[3]),
        "tty_device": int(fields[4]) & 0xFFFFFFFF,
        "started": int(fields[19]),
    }


def tty_name(device):
    major, minor = os.major(device), os.minor(device)
    if 136 <= major <= 143:
        return f"pts/{(major - 136) * 256 + minor}"
    return f"{major}:{minor}"


def discover(app_pid, proc_root):
    try:
        # Establish that procfs is usable even when no sessions match.
        parse_stat((proc_root / "self" / "stat").read_text())
        processes = list(proc_root.iterdir())
    except (OSError, ValueError, IndexError) as error:
        raise DiscoveryError("cannot read the process table") from error

    sessions = []
    for process in processes:
        if not process.name.isascii() or not process.name.isdecimal():
            continue
        try:
            if process.stat().st_uid != os.getuid():
                continue
            info = parse_stat((process / "stat").read_text(errors="replace"))
        except (FileNotFoundError, ProcessLookupError):
            continue  # The process exited during the scan.
        except (OSError, ValueError, IndexError) as error:
            # An unreadable same-user record might be a session. Do not
            # quietly turn an incomplete snapshot into a successful count.
            raise DiscoveryError(f"cannot inspect process {process.name}") from error
        if (
            info["ppid"] == app_pid
            and info["pid"] == info["sid"]
            and info["tty_device"] != 0
            and info["state"] not in ("Z", "X", "x")
        ):
            sessions.append(info)

    sessions.sort(key=lambda item: (item["started"], item["pid"]))
    return [
        {"pid": item["pid"], "tty": tty_name(item["tty_device"]), "command": item["command"]}
        for item in sessions
    ]


def plain_text(value):
    return "".join("?" if unicodedata.category(char).startswith("C") else char for char in value)


def ancestry(pid, proc_root):
    """Return a bounded ancestor chain; unreadable or cyclic chains stop here."""
    chain = []
    for _ in range(256):
        if pid <= 1 or pid in chain:
            break
        try:
            record = parse_stat((proc_root / str(pid) / "stat").read_text(errors="replace"))
            if record["pid"] != pid:
                break
        except (OSError, ValueError, IndexError):
            break
        chain.append(pid)
        pid = record["ppid"]
    return chain


def from_chain(chain, sessions):
    by_pid = {session["pid"]: index for index, session in enumerate(sessions)}
    return next((by_pid[pid] for pid in chain if pid in by_pid), None)


def resolve_current(sessions, proc_root, env, *, pid=None, tty=None):
    if tty is not None:
        tty = tty.removeprefix("/dev/")
        return next((i for i, session in enumerate(sessions) if session["tty"] == tty), None)
    chain = ancestry(pid if pid is not None else os.getppid(), proc_root)
    if pid is not None:
        return from_chain(chain, sessions)
    if not env.get("TMUX"):
        return from_chain(chain, sessions)

    # A server's launching ancestry is not the viewing client's ancestry.
    # Only a pane whose root belongs to our own chain is a valid context.
    deadline = time.monotonic() + 0.250

    def query(*args):
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise TimeoutError
        return subprocess.run(
            ["tmux", *args], capture_output=True, text=True, check=True,
            timeout=remaining, env=env,
        ).stdout

    try:
        panes = query("list-panes", "-a", "-F", "#{pane_id} #{pane_pid}")
        candidates = []
        for line in panes.splitlines():
            pane, root = line.split()
            if int(root) in chain:
                candidates.append((chain.index(int(root)), pane))
        if not candidates:
            return None
        pane = min(candidates)[1]
        if env.get("TMUX_PANE") and env["TMUX_PANE"] != pane:
            return None
        clients = query("list-clients", "-t", pane, "-F", "#{client_pid} #{client_control_mode}")
        clients = [line.split() for line in clients.splitlines()]
        clients = [int(client) for client, control in clients if control == "0"]
        if len(clients) == 1:
            return from_chain(ancestry(clients[0], proc_root), sessions)
    except (OSError, ValueError, subprocess.SubprocessError, TimeoutError):
        pass
    return None


def template_fields(template):
    fields = set()
    for _, field, spec, conversion in string.Formatter().parse(template):
        if field is None:
            continue
        if field not in FIELDS or spec or conversion:
            raise ValueError("templates accept only plain {field} placeholders; see --fields")
        fields.add(field)
    # Formatter treats {field:} as an empty spec; reject that spelling too.
    # Scan actual replacement tokens while respecting escaped literal braces.
    i = 0
    while i < len(template):
        if template[i:i + 2] in ("{{", "}}"):
            i += 2
        elif template[i] == "{":
            end = template.index("}", i)
            if template[i + 1:end] not in FIELDS:
                raise ValueError("templates accept only plain {field} placeholders; see --fields")
            i = end + 1
        else:
            i += 1
    return fields


def query_values(requested, sessions, proc_root, env, args):
    total = len(sessions)
    values = {"total": total}
    if total:
        values.update(first=1, last=total)
    if requested - {"total", "first", "last"}:
        index = resolve_current(sessions, proc_root, env, pid=args.pid, tty=args.tty)
        if index is not None:
            values.update(sessions[index])
            values["command"] = plain_text(values["command"])
            values.update(current=index + 1, number=index + 1,
                          previous=(index - 1) % total + 1, next=(index + 1) % total + 1)
    missing = requested - values.keys()
    if missing:
        raise DiscoveryError("session context unavailable for " + ", ".join(sorted(missing))
                             + "; use --tty or --pid to select a live Termux session")
    return values


def completion_source(shell):
    kinds = {name: kind or "" for names, _, kind, _ in OPTIONS for name in names}
    kinds.update({alias: kinds[option] for alias, option in ALIASES.items()})
    choices = " ".join(FIELDS)
    root = " ".join(name for names, _, _, group in OPTIONS if group not in ("install",)
                    for name in names) + " " + " ".join(ALIASES)
    if shell == "bash":
        cases = "\n".join(f"    {name}) printf '%s' {shlex.quote(kind)} ;;"
                          for name, kind in kinds.items() if kind)
        return r'''# Generated by termux-sessions; no runtime session discovery.
_termux_sessions_kind() {
  case $1 in
@CASES@
  esac
}
_termux_sessions() {
  local cur=${COMP_WORDS[COMP_CWORD]} word kind='' mode='' lead='' prefix fragment field i
  COMPREPLY=()
  for ((i=1; i<COMP_CWORD; i++)); do
    word=${COMP_WORDS[i]}
    if [[ -n $kind ]]; then
      if [[ $kind != shell || $word != -* ]]; then kind=''; continue; fi
      kind=''
    fi
    case $word in
      get|-g|--get|--get=*) mode=get ;;
      format|-f|--format|--format=*) mode=format ;;
      completion|--completion|--completion=*) mode=completion ;;
    esac
    kind=$(_termux_sessions_kind "${word%%=*}")
    [[ $word == *=* ]] && kind=''
  done
  if [[ $cur == --*=* ]]; then
    kind=$(_termux_sessions_kind "${cur%%=*}")
    lead=${cur%%=*}=
    cur=${cur#*=}
  fi
  [[ $kind == shell && $cur == -* ]] && kind=''
  case $kind in
    field) mapfile -t COMPREPLY < <(compgen -W '@FIELDS@' -- "$cur") ;;
    shell) mapfile -t COMPREPLY < <(compgen -W '@SHELLS@' -- "$cur") ;;
    directory)
      mapfile -t COMPREPLY < <(compgen -d -- "$cur")
      compopt -o filenames 2>/dev/null || : ;;
    template)
      prefix=''; fragment=$cur
      if [[ $cur == *\{* ]]; then prefix=${cur%\{*}; fragment=${cur##*\{}; fi
      for field in @FIELDS@; do
        [[ $field == "$fragment"* ]] && COMPREPLY+=("${prefix}{${field}}")
      done ;;
    pid|tty) ;;
    *)
      case $mode in
        completion) word='--install --all --dir -h --help' ;;
        get|format) word='--pid --tty -h --help' ;;
        *) word='@ROOT@' ;;
      esac
      mapfile -t COMPREPLY < <(compgen -W "$word" -- "$cur") ;;
  esac
  if [[ -n $lead ]]; then
    for ((i=0; i<${#COMPREPLY[@]}; i++)); do COMPREPLY[i]=$lead${COMPREPLY[i]}; done
  fi
  return 0
}
complete -F _termux_sessions termux-sessions
'''.replace("@CASES@", cases).replace("@FIELDS@", choices).replace(
            "@SHELLS@", " ".join(SHELLS)).replace("@ROOT@", root)
    if shell == "zsh":
        actions = {"field": "(" + choices + ")", "shell": "(" + " ".join(SHELLS) + ")",
                   "template": "->template", "directory": "_files -/", "pid": "", "tty": ""}
        groups = {}
        for group in ("mode", "selector", "install", "help"):
            specs = []
            for names, description, kind, category in OPTIONS:
                if category != group:
                    continue
                exclusion = ""
                if group in ("mode", "selector"):
                    exclusion = "(" + " ".join(n for ns, _, _, g in OPTIONS if g == group for n in ns) + ")"
                for name in names:
                    value = (":" if kind != "shell" else "::") + kind + ":" + actions[kind] if kind else ""
                    spelling = name + "=" if kind and name.startswith("--") else name
                    specs.append(shlex.quote(exclusion + spelling + "[" + description + "]" + value))
            groups[group] = " ".join(specs)
        return r'''#compdef termux-sessions
# Generated by termux-sessions; no runtime session discovery.
_termux_sessions() {
  local context state state_descr line curcontext="$curcontext" prefix fragment field template_lead=''
  local -a specs candidates
  typeset -A opt_args
  [[ ${words[CURRENT]} == --format=* ]] && template_lead='--format='
  specs=(@SELECTOR@ @HELP@)
  case ${words[2]} in
    get) words=($words[1] $words[3,-1]); (( CURRENT-- )); specs+=('1:field:(@FIELDS@)') ;;
    format) words=($words[1] $words[3,-1]); (( CURRENT-- )); specs+=('1:template:->template') ;;
    completion) words=($words[1] $words[3,-1]); (( CURRENT-- )); specs=(@HELP@ @INSTALL@ '1:shell:(@SHELLS@)') ;;
    *)
      specs+=(@MODE@ '1:command:(get format completion)')
      if (( ${words[(I)--completion*]} )); then specs+=(@INSTALL@); fi ;;
  esac
  _arguments -C $specs && return 0
  if [[ $state == template ]]; then
    fragment=${(Q)PREFIX}; fragment=${fragment#--format=}; prefix=''
    if [[ $fragment == *\{* ]]; then prefix=${fragment%\{*}; fragment=${fragment##*\{}; fi
    for field in @FIELDS@; do
      [[ $field == "$fragment"* ]] && candidates+=("${prefix}{${field}}")
    done
    compadd -Q -U -P "$template_lead" -a candidates
  fi
}
_termux_sessions "$@"
'''.replace("@FIELDS@", choices).replace("@SHELLS@", " ".join(SHELLS)).replace(
            "@SELECTOR@", groups["selector"]).replace("@HELP@", groups["help"]).replace(
            "@MODE@", groups["mode"]).replace("@INSTALL@", groups["install"])
    # Fish conditions parse words without executing termux-sessions. The
    # helper prints a value kind, or a mode after its value has been consumed.
    cases = "\n".join("            case " + shlex.quote(name) + "\n                set pending "
                      + shlex.quote(kind) for name, kind in kinds.items() if kind)
    source = '''# Generated by termux-sessions; no runtime session discovery.
function __termux_sessions_context
    set -l words (commandline -opc)
    set -l pending ''
    set -l mode root
    for word in $words[2..-1]
        if test -n "$pending"
            if test "$pending" != shell; or not string match -q -- '-*' "$word"
                set pending ''
                continue
            end
            set pending ''
        end
        switch $word
            case get -g --get '--get=*'
                set mode get
            case format -f --format '--format=*'
                set mode format
            case completion --completion '--completion=*'
                set mode completion
        end
        switch (string split -m1 = -- "$word")[1]
@CASES@
        end
        if string match -q '*=*' -- "$word"
            set pending ''
        end
    end
    set -l token (commandline -ct)
    if string match -q -- '--*=*' "$token"
        switch (string split -m1 = -- "$token")[1]
@CASES@
        end
    end
    if test "$pending" = shell; and string match -q -- '-*' "$token"
        set pending ''
    end
    if test -n "$pending"
        printf '%s\\n' "$pending"
    else
        printf '%s\\n' "$mode"
    end
end
complete -c termux-sessions -f
complete -c termux-sessions -n 'test (__termux_sessions_context) = root' -a 'get format completion'
complete -c termux-sessions -n 'test (__termux_sessions_context) = field' -a '@FIELDS@'
complete -c termux-sessions -n 'test (__termux_sessions_context) = shell' -a '@SHELLS@'
complete -c termux-sessions -n 'test (__termux_sessions_context) = directory' -a '(__fish_complete_directories)'
'''.replace("@CASES@", cases).replace("@FIELDS@", choices).replace("@SHELLS@", " ".join(SHELLS))
    source += r'''function __termux_sessions_templates
    set -l token (commandline -ct)
    set token (string replace -r '^--format=' '' -- "$token")
    set token (string replace -r "^[\"']" '' -- "$token")
    set -l prefix ''
    if string match -q '*{*' -- "$token"
        set prefix (string replace -r '\{[^{]*$' '' -- "$token")
    end
    for field in @FIELDS@
        printf '%s{%s}\n' "$prefix" "$field"
    end
end
complete -c termux-sessions -n 'test (__termux_sessions_context) = template' -a '(__termux_sessions_templates)'
'''.replace("@FIELDS@", choices)
    for names, description, kind, group in OPTIONS:
        condition = {"mode": "contains -- (__termux_sessions_context) root",
                     "selector": "contains -- (__termux_sessions_context) root get format",
                     "install": "contains -- (__termux_sessions_context) completion shell",
                     "help": "contains -- (__termux_sessions_context) root get format completion shell"}[group]
        if group == "mode" and kind:
            condition += " " + kind
        flags = " ".join(("-l " + name[2:]) if name.startswith("--") else ("-s " + name[1:]) for name in names)
        source += "complete -c termux-sessions " + flags + " -n " + shlex.quote(condition)
        source += " -d " + shlex.quote(description)
        if kind:
            if kind != "shell":
                source += " -r"
            if kind in ("field", "shell", "template"):
                source += " -a " + shlex.quote({"field": choices, "shell": " ".join(SHELLS),
                                                "template": "(__termux_sessions_templates)"}[kind])
        source += "\n"
    return source


def completion_targets(shells, directory, env):
    home = Path(env.get("HOME") or str(Path.home()))
    data = Path(env.get("XDG_DATA_HOME") or home / ".local/share")
    config = Path(env.get("XDG_CONFIG_HOME") or home / ".config")
    bash_base = next((Path(p) for p in env.get("BASH_COMPLETION_USER_DIR", "").split(":") if p),
                     data / "bash-completion")
    prefix = env.get("TERMUX__PREFIX") or env.get("PREFIX")
    defaults = {"bash": bash_base / "completions",
                "zsh": Path(prefix) / "share/zsh/site-functions" if prefix else data / "zsh/site-functions",
                "fish": config / "fish/completions"}
    filenames = {"bash": "termux-sessions.bash", "zsh": "_termux-sessions", "fish": "termux-sessions.fish"}
    return [(shell, (Path(directory).expanduser() if directory else defaults[shell]) / filenames[shell])
            for shell in shells]


def install_completions(targets):
    pending = []
    # Validate every leaf and its nearest existing parent before any writes.
    for shell, path in targets:
        if path.is_symlink() or (path.exists() and not path.is_file()):
            raise OSError(f"refusing non-regular completion target: {path}")
        parent = path.parent
        while not parent.exists():
            parent = parent.parent
        if not parent.is_dir() or not os.access(parent, os.W_OK):
            raise OSError(f"completion directory is not writable: {parent}")
        content = completion_source(shell).encode()
        old = path.read_bytes() if path.exists() else None
        pending.append((path, content, old))
    for path, content, old in pending:
        if old == content:
            print(f"unchanged: {path}", file=sys.stderr)
            continue
        path.parent.mkdir(parents=True, exist_ok=True)
        mode = stat.S_IMODE(path.stat().st_mode) if old is not None else 0o644
        if old is not None:
            with tempfile.NamedTemporaryFile(prefix=path.name + ".bak.", dir=path.parent, delete=False) as backup:
                backup.write(old)
            os.chmod(backup.name, mode)
            print(f"backup: {backup.name}", file=sys.stderr)
        temporary = None
        try:
            with tempfile.NamedTemporaryFile(prefix="." + path.name + ".", dir=path.parent, delete=False) as stream:
                temporary = Path(stream.name)
                stream.write(content)
            temporary.chmod(mode)
            os.replace(temporary, path)
        finally:
            if temporary is not None:
                temporary.unlink(missing_ok=True)
        print(f"installed: {path}", file=sys.stderr)


def normalize_args(argv):
    normalized, awaiting = [], False
    value_flags = {name for names, _, kind, _ in OPTIONS if kind for name in names}
    for arg in argv:
        if awaiting and not arg.startswith("-"):
            normalized.append(arg)
            awaiting = False
            continue
        arg = ALIASES.get(arg, arg)
        normalized.append(arg)
        awaiting = arg in value_flags
    return normalized


def main(argv=None, *, proc_root=Path("/proc"), environ=None):
    parser = argparse.ArgumentParser(
        description="Report live Termux terminal sessions (default: termux:COUNT).",
        add_help=False,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Session queries require readable procfs and inherited TERMUX_APP__PID.\n"
            "Excludes nested shells, tmux panes, and exited tabs. Numbers follow\n"
            "creation order, not drawer numbering or the selected tab. Each call\n"
            "takes a fresh snapshot; no background tracker is needed.\n\n"
            "Aliases: get FIELD, format TEMPLATE, completion SHELL.\n"
            "Completion shells: bash, zsh, fish. Use --all --install for all three.\n"
            "Completion, --fields, and --help work without session discovery.\n\n"
            "Fields:\n" + "\n".join(f"  {name:10} {description}" for name, description in FIELDS.items())
        ),
    )
    groups = {"mode": parser.add_mutually_exclusive_group(),
              "selector": parser.add_mutually_exclusive_group(), "install": parser, "help": parser}
    for names, description, kind, group in OPTIONS:
        kwargs = {"help": description}
        if group == "help":
            kwargs["action"] = "help"
        elif not kind:
            kwargs["action"] = "store_true"
        elif kind == "field":
            kwargs.update(choices=tuple(FIELDS), metavar="FIELD")
        elif kind == "shell":
            kwargs.update(nargs="?", const="", choices=("", *SHELLS), metavar="SHELL")
        elif kind == "template":
            kwargs["metavar"] = "TEMPLATE"
        elif kind == "pid":
            kwargs["type"] = int
        groups[group].add_argument(*names, **kwargs)
    args = parser.parse_args(normalize_args(sys.argv[1:] if argv is None else argv))
    env = os.environ if environ is None else environ
    if args.completion is not None:
        if args.pid is not None or args.tty is not None:
            parser.error("completion does not accept session selectors")
        if args.all and (not args.install or args.completion):
            parser.error("--all requires --install and no individual shell")
        if not args.all and not args.completion:
            parser.error("completion requires bash, zsh, fish, or --all --install")
        if args.dir is not None and not args.install:
            parser.error("--dir requires --install")
        if args.dir == "":
            parser.error("--dir must not be empty")
        if args.install:
            try:
                targets = completion_targets(SHELLS if args.all else (args.completion,), args.dir, env)
                install_completions(targets)
                for shell, path in targets:
                    if shell == "zsh":
                        print(f"zsh: ensure {path.parent} is in fpath before compinit; rebuild completion discovery",
                              file=sys.stderr)
            except OSError as error:
                print(f"termux-sessions: {error}; any completed installs/backups are listed above", file=sys.stderr)
                return 1
        else:
            print(completion_source(args.completion), end="")
        return 0
    if args.install or args.all or args.dir is not None:
        parser.error("--install, --all, and --dir require completion")
    querying = args.get is not None or args.format is not None
    if (args.pid is not None or args.tty is not None) and not querying:
        parser.error("--pid and --tty require --get or --format")
    if args.pid is not None and args.pid <= 0:
        parser.error("--pid must be positive")
    if args.tty is not None:
        tty = args.tty.removeprefix("/dev/")
        if not tty.startswith("pts/") or not tty[4:].isascii() or not tty[4:].isdecimal():
            parser.error("--tty must be pts/N or /dev/pts/N")
    if args.fields:
        print("\n".join(FIELDS))
        return 0
    try:
        requested = {args.get} if args.get is not None else template_fields(args.format) if args.format is not None else set()
    except ValueError as error:
        parser.error(str(error))
    value = env.get("TERMUX_APP__PID", "")
    if not value.isascii() or not value.isdecimal() or len(value) > 10 or int(value) <= 0:
        print("termux-sessions: TERMUX_APP__PID must be a positive process ID", file=sys.stderr)
        return 1
    try:
        sessions = discover(int(value), proc_root)
        if querying:
            values = query_values(requested, sessions, proc_root, env, args)
            output = str(values[args.get]) if args.get is not None else args.format.format_map(values)
    except DiscoveryError as error:
        print(f"termux-sessions: {error}", file=sys.stderr)
        return 1

    if querying:
        print(output)
    elif args.json:
        print(json.dumps({"count": len(sessions), "sessions": sessions}))
    elif args.list:
        print("PID\tTTY\tCOMMAND")
        for session in sessions:
            print(f"{session['pid']}\t{session['tty']}\t{plain_text(session['command'])}")
    elif args.count:
        print(len(sessions))
    else:
        print(f"termux:{len(sessions)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
