{
  "schema": 1,
  "repository": "termux",
  "resources": [
    {
      "id": "fastfetch",
      "source": "config/fastfetch",
      "app": "fastfetch",
      "category": "config",
      "platforms": [
        "termux"
      ],
      "target": "${CONFIG}/fastfetch",
      "strategy": "directory-link",
      "replaces": [
        "dots:fastfetch"
      ]
    },
    {
      "id": "htop",
      "source": "config/htop",
      "app": "htop",
      "category": "config",
      "platforms": [
        "termux"
      ],
      "target": "${CONFIG}/htop",
      "strategy": "directory-link",
      "replaces": [
        "dots:htop"
      ]
    },
    {
      "id": "pip",
      "source": "config/pip",
      "app": "pip",
      "category": "config",
      "platforms": [
        "termux"
      ],
      "target": "${CONFIG}/pip",
      "strategy": "directory-link"
    },
    {
      "id": "tmux",
      "source": "config/tmux",
      "app": "tmux",
      "category": "config",
      "platforms": [
        "termux"
      ],
      "target": "${CONFIG}/tmux",
      "strategy": "directory-link"
    }
  ]
}
