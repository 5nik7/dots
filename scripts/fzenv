#!/usr/bin/env bash

_dots_script_source=$(readlink -f -- "${BASH_SOURCE[0]}")
DOTS=${DOTS:-$(cd -- "${_dots_script_source%/*}/.." && pwd -P)}
source "$DOTS/lib/dots/script_style.bash"

main() {
  dots::icon navigation.environment '󰇁'; local prompt=$REPLY
  dots::icon navigation.next '󰅂'; prompt+=$REPLY
  local c21=$DOTS_UI_BLUE
  (env | sed "s/=/…/") | fzf --smart-case \
    --prompt "$prompt " \
    --height '100%' \
    --ansi --cycle \
    -d … \
    --with-nth '{1}' \
    --preview-window='default:50%:down:wrap-word:border-sharp' \
    --preview-label-pos 'top' \
    --preview "printf '${c21}%s${rst}\n${bold}%s${rst}' {1} {2}" \
    --query "${1:-}" \
    --accept-nth '{1}={2}'
}

main "$@"
