#!/usr/bin/env bash

_dots_script_source=$(readlink -f -- "${BASH_SOURCE[0]}")
DOTS=${DOTS:-$(cd -- "${_dots_script_source%/*}/.." && pwd -P)}
source "$DOTS/lib/dots/script_style.bash"

output=''

figfonts() {
  local dir=$(command figlet -I2)
  find $dir -type f -name '*.flf' -printf '%f\n' | cut -d. -f1 | sort 2>/dev/null
}

main() {
  local cmd
  local pipe=0
  local text='test'
  local preview
  while (($#)); do
    case $1 in
    -p | --pipe)
      pipe=1
      cmd=$2
      shift 2
      ;;
    *) break ;;
    esac
  done

  [[ -n $1 ]] && text="$*"

  if ((pipe)); then
    preview="figlet -f {} ${text} | $cmd"
  else
    preview="figlet -f {} ${text}"
  fi

  dots::icon navigation.next '󰅂'; local next=$REPLY
  local output=$(figlet -f "$(figfonts | fzf --smart-case --cycle \
    --prompt "$text$next " \
    --height '100%' \
    --preview-window='default:down:50%:nowrap:border-sharp' --preview="$preview")" "$text" 2>/dev/null)
  [[ ! -n "$output" ]] || echo -e "$output" | cpy && echo "$output"
}

main "$@"
