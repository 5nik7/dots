# Identity
[user]
  name = njen
  email = contact@njen.io

[github]
  user = 5nik7

[init]
  defaultBranch = main

# Fetch / pull / push
[fetch]
  prune = true
  pruneTags = false

[pull]
  rebase = true

[push]
  default = simple
  autoSetupRemote = true
  followTags = false
  useForceIfIncludes = true

[rebase]
  autoSquash = true

# Rewrite HTTPS pushes for your GitHub username only.
[url "git@github.com:5nik7/"]
  pushInsteadOf = https://github.com/5nik7/

# Editing and line endings; filesystem capabilities stay repository-local.
[core]
  editor = nvim
  pager = delta
  autocrlf = input
  whitespace = trailing-space,space-before-tab

[interactive]
  diffFilter = delta --color-only

[help]
  autocorrect = prompt

[log]
  date = auto:human

# Terminal colors
[color]
  ui = auto

[color "branch"]
  current = yellow bold
  local = green bold
  remote = cyan bold

[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold
  whitespace = red reverse

[color "status"]
  added = green bold
  changed = yellow bold
  untracked = red bold

[include]
  path = gitppuccin
  path = gitaliases

[delta]
  features = catppuccin-mocha
  navigate = true
  side-by-side = false
  line-numbers = true
  true-colors = always

