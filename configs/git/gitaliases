# Git aliases: shell helpers use POSIX sh, not Bash/Zsh-only syntax.
# Read README.md for changed/removed shortcuts and examples.
[alias]

  # Stage / apply patches
  a = "add --all"
  ai = "add -i"
  ap = "apply"
  as = "apply --stat"
  ac = "apply --check"
  ama = "am --abort"
  amr = "am --continue"
  ams = "am --skip"

  # Branches (bdd force-deletes a local branch)
  b = "branch"
  ba = "branch -a"
  bd = "branch -d"
  bdd = "branch -D"
  br = "branch -r"
  bc = "branch --show-current"
  bu = "rev-parse --abbrev-ref --symbolic-full-name @{upstream}"

  # Commits (cd/cad/ced amend the last commit)
  c = "commit"
  ca = "commit -a"
  cm = "commit -m"
  cam = "commit -am"
  cem = "commit --allow-empty -m"
  cd = "commit --amend"
  cad = "commit -a --amend"
  ced = "commit --allow-empty --amend"

  # Clone
  cl = "clone"
  cld = "clone --depth 1"
  clg = "!f() { [ \"$#\" -ge 1 ] && [ \"$#\" -le 2 ] || { printf '%s\\n' 'Usage: git clg OWNER/REPO [DIRECTORY]' >&2; return 2; }; repo=$1; shift; git clone -- \"https://github.com/$repo\" \"$@\"; }; f"
  clgp = "!f() { [ \"$#\" -ge 1 ] && [ \"$#\" -le 2 ] || { printf '%s\\n' 'Usage: git clgp REPO [DIRECTORY]' >&2; return 2; }; owner=$(git config --get github.user) && [ -n \"$owner\" ] || { printf '%s\\n' 'Set github.user first.' >&2; return 1; }; repo=$1; shift; git clone -- \"git@github.com:$owner/$repo\" \"$@\"; }; f"

  # Cherry-pick
  cp = "cherry-pick"
  cpa = "cherry-pick --abort"
  cpc = "cherry-pick --continue"

  # Diff
  d = "diff"
  dp = "diff --patience"
  dc = "diff --cached"
  dk = "diff --check"
  dck = "diff --cached --check"
  dt = "difftool"
  dct = "difftool --cached"

  # Fetch / inspection
  f = "fetch"
  fo = "fetch origin"
  fu = "fetch upstream"
  fp = "format-patch"
  fk = "fsck"
  g = "grep -p"

  # Log / tracked files
  lgs = "log --graph --pretty=format:'%C(auto)%h %d%Creset %s %Cgreen(%cs)%Creset %C(bold blue)<%an>%Creset' --abbrev-commit"
  lgr = "log --graph --pretty=format:'%C(auto)%h %d%Creset %s %Cgreen(%cr)%Creset %C(bold blue)<%an>%Creset' --abbrev-commit --all"
  l = "log --oneline"
  lg = "log --oneline --graph --decorate"
  ls = "ls-files"
  lsf = "!f() { [ \"$#\" -eq 1 ] || { printf '%s\\n' 'Usage: git lsf PATTERN' >&2; return 2; }; git ls-files | grep -i -- \"$1\"; }; f"

  # Merge / checkout
  m = "merge"
  ma = "merge --abort"
  mc = "merge --continue"
  o = "checkout"
  ob = "checkout -b"

  # Push (pst pushes ALL tags; psao pushes ALL local branches)
  ps = "push"
  psdry = "push --dry-run"
  psf = "push --force-with-lease"
  psu = "push -u"
  pst = "push --tags"
  pso = "push origin"
  psao = "push --all origin"
  psfo = "push --force-with-lease origin"
  psuo = "push -u origin"

  # Current branch -> same-named origin branch; optional push flags
  psoc = "!f() { ref=$(git symbolic-ref --quiet HEAD) || { printf '%s\\n' 'A named branch is required; HEAD is detached.' >&2; return 1; }; git push origin \"HEAD:$ref\" \"$@\"; }; f"
  psfoc = "!f() { ref=$(git symbolic-ref --quiet HEAD) || { printf '%s\\n' 'A named branch is required; HEAD is detached.' >&2; return 1; }; git push --force-with-lease origin \"HEAD:$ref\" \"$@\"; }; f"
  psuoc = "!f() { ref=$(git symbolic-ref --quiet HEAD) || { printf '%s\\n' 'A named branch is required; HEAD is detached.' >&2; return 1; }; git push --set-upstream origin \"HEAD:$ref\" \"$@\"; }; f"

  # Pull (pull.rebase=true is retained)
  pl = "pull"
  pb = "pull --rebase"
  plo = "pull origin"
  pbo = "pull --rebase origin"
  ploc = "!f() { ref=$(git symbolic-ref --quiet HEAD) || { printf '%s\\n' 'A named branch is required; HEAD is detached.' >&2; return 1; }; git pull origin \"$ref\" \"$@\"; }; f"
  pboc = "!f() { ref=$(git symbolic-ref --quiet HEAD) || { printf '%s\\n' 'A named branch is required; HEAD is detached.' >&2; return 1; }; git pull --rebase origin \"$ref\" \"$@\"; }; f"
  plu = "pull upstream"
  pluc = "!f() { ref=$(git symbolic-ref --quiet HEAD) || { printf '%s\\n' 'A named branch is required; HEAD is detached.' >&2; return 1; }; git pull upstream \"$ref\" \"$@\"; }; f"
  pbuc = "!f() { ref=$(git symbolic-ref --quiet HEAD) || { printf '%s\\n' 'A named branch is required; HEAD is detached.' >&2; return 1; }; git pull --rebase upstream \"$ref\" \"$@\"; }; f"

  # Rebase
  rb = "rebase"
  rba = "rebase --abort"
  rbc = "rebase --continue"
  rbi = "rebase --interactive"
  rbs = "rebase --skip"

  # Reset (--hard aliases discard tracked working changes)
  re = "reset"
  rh = "reset HEAD"
  reh = "reset --hard"
  rem = "reset --mixed"
  res = "reset --soft"
  rehh = "reset --hard HEAD"
  remh = "reset --mixed HEAD"
  resh = "reset --soft HEAD"

  # Remotes
  r = "remote"
  ra = "remote add"
  rr = "remote rm"
  rv = "remote -v"
  rn = "remote rename"
  rp = "remote prune"
  rs = "remote show"
  rao = "remote add origin"
  rau = "remote add upstream"
  rro = "remote remove origin"
  rru = "remote remove upstream"
  rso = "remote show origin"
  rsu = "remote show upstream"
  rpo = "remote prune origin"
  rpu = "remote prune upstream"

  # Remove tracked files (forced removal)
  rmf = "rm -f"
  rmrf = "rm -r -f"

  # Status
  s = "status"
  sb = "status -s -b"

  # Stash (sc clears ALL stashes; ss -m MESSAGE sets a message)
  sa = "stash apply"
  sc = "stash clear"
  sd = "stash drop"
  sl = "stash list"
  sp = "stash pop"
  ss = "stash push"
  sw = "stash show"
  st = "!git stash list --format=%gd | wc -l"
  snap = "!f() { [ \"$#\" -eq 0 ] || { printf '%s\\n' 'Usage: git snap' >&2; return 2; }; message=\"snapshot: $(date '+%Y-%m-%d %H:%M:%S%z')\"; snapshot=$(git stash create \"$message\") || return; if [ -z \"$snapshot\" ]; then printf '%s\\n' 'No tracked changes to snapshot.'; return 0; fi; git stash store -m \"$message\" \"$snapshot\"; }; f"

  # Tags / show
  t = "tag"
  td = "tag -d"
  w = "show"
  wp = "show -p"
  wr = "show -p --no-color"

  # SVN (requires git-svn)
  svnr = "svn rebase"
  svnd = "svn dcommit"
  svnl = "svn log --oneline --show-commit"

  # Submodules (subup initializes recursively only when invoked)
  subadd = "!f() { [ \"$#\" -ge 1 ] && [ \"$#\" -le 2 ] || { printf '%s\\n' 'Usage: git subadd OWNER/REPO [PARENT_DIRECTORY]' >&2; return 2; }; repo=$1; path=${repo##*/}; path=${path%.git}; if [ \"$#\" -eq 2 ]; then path=${2%/}/$path; fi; git submodule add -- \"https://github.com/$repo\" \"$path\"; }; f"
  subup = "submodule update --init --recursive"
  substatus = "submodule status --recursive"

  # Index hints; NOT an ignore mechanism for tracked configuration
  assume = "update-index --assume-unchanged"
  unassume = "update-index --no-assume-unchanged"
  assumed = "!git ls-files -v | sed -n 's/^[a-z] //p'"

  # Other tools (serve binds IPv4 loopback only)
  aliases = "config --get-regexp '^alias[.]'"
  whois = "!f() { [ \"$#\" -eq 1 ] || { printf '%s\\n' 'Usage: git whois AUTHOR_PATTERN' >&2; return 2; }; git log -i -1 \"--author=$1\" --format='%an <%ae>'; }; f"
  serve = "daemon --reuseaddr --verbose --listen=127.0.0.1 --base-path=. --export-all ./.git"
  behind = "rev-list --left-only --count @{upstream}...HEAD"
  ahead = "rev-list --right-only --count @{upstream}...HEAD"
  ours = "!f() { [ \"$#\" -gt 0 ] || { printf '%s\\n' 'Usage: git ours PATH...' >&2; return 2; }; git -C \"${GIT_PREFIX:-.}\" checkout --ours -- \"$@\" && git -C \"${GIT_PREFIX:-.}\" add -- \"$@\"; }; f"
  theirs = "!f() { [ \"$#\" -gt 0 ] || { printf '%s\\n' 'Usage: git theirs PATH...' >&2; return 2; }; git -C \"${GIT_PREFIX:-.}\" checkout --theirs -- \"$@\" && git -C \"${GIT_PREFIX:-.}\" add -- \"$@\"; }; f"
  human = "name-rev --name-only --refs=refs/heads/*"

