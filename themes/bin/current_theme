#!/usr/bin/env bash
DT_LIB=$(cd -- "${BASH_SOURCE[0]%/*}/../../lib/dots/themes" && pwd) || exit
source "$DT_LIB/core.bash"
if [[ ${1:-} == init || ${1:-} == --init ]]; then
  shift
  source "$DT_LIB/views.bash"
  dt_init "$@"
  exit $?
fi
dt_selected || exit
export FLAVOR=$DT_FLAVOR
if [[ $DT_THEME == catppuccin ]]; then source "$DT_LIB/legacy.bash"
else source "$DT_LIB/current.bash"
fi
