#!/usr/bin/env bash

declare -gA theme
declare -gA themes

themes[cmdname]="${0##*/}"
themes[default]="${themes[root]}/.default"
themes[global]="${themes[root]}/.theme"
themes[local]="${HOME}/.theme"

if [[ -r "${themes[local]}" ]]; then
  themes[file]="${themes[local]}"
elif [[ -r "${themes[global]}" ]]; then
  themes[file]="${themes[global]}"
else
  themes[file]="${themes[default]}"
fi

has_theme() { command vivid generate "$1" &>/dev/null; }

change_theme() {
  local new="$1"
  local old="$THEME"
  if has_theme "$new"; then
    if [[ $new == "$old" ]]; then
      warn "'$new' is current theme."
      return 1
    else
      echo "$new" >|"${THEMEFILE:-${themes[file]}}"
      set_theme "$new"
    fi
  else
    err "'$new' not a theme."
    return 1
  fi
}

set_theme() {
  local t out

  if [[ -n "$1" ]]; then
    t="$1"
  else
    t="$(<"${themes[file]}")"
  fi

  if [[ $t == *-* ]]; then
    theme[current]="${t%%-*}"
    theme[flavor]="${t#*-}"
    theme[flavor]="${theme[flavor]%%-*}"
    export THEME="${theme[current]}"
    export FLAVOR="${theme[flavor]}"
    out="THEME:$THEME|FLAVOR:$FLAVOR"
  else
    theme[current]="$t"
    export THEME="${theme[current]}"
    out="THEME:$THEME"
  fi
  
  export THEMEDIR="${themes[root]}/$THEME"
  export THEMESRC="$THEMEDIR/src"

  local colors
  if [[ -n ${ZSH_VERSION:-} ]] && (( ${+functions[_dots_vivid_colors]} )); then
    _dots_vivid_colors "$t" && colors=$REPLY
  else
    colors="$(command vivid generate "$t")" 2>/dev/null
  fi
  export LS_COLORS="$colors"

  eval "$(current_theme init)"

  # Reapplying a theme replaces its FZF colors instead of appending copies.
  if [[ -n ${_FZF_OPTS_:-} ]]; then
    export FZF_DEFAULT_OPTS="$_FZF_OPTS_ --bind=$_FZF_BINDS_ --preview-window=$_FZF_PREVIEW_POS_ --preview='$_PREVIEW_ {}'"
  fi
  local file
  for file in "$THEMESRC"/*; do
    [[ -f $file ]] || continue
    # shellcheck source=/dev/null
    . "$file"
  done

  if [[ -n "$1" ]]; then
    ok "$out"
  fi
}
