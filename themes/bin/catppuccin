  surface0='#ccd0da'
  crust='#dce0e8'
  mantle='#e6e9ef'
  base='#eff1f5'
}

load_flavor() {
  case "$1" in
    mocha) mocha ;;
    macchiato) macchiato ;;
    frappe) frappe ;;
    latte) latte ;;
    *) return 1 ;;
  esac

  current_palette=()
  current_rgb=()
  current_ansi8=()

  local color hex rgb
  for color in "${palette[@]}"; do
    hex="${!color}"
    current_palette["$color"]="$hex"
    rgb="$(hex_to_rgb "$hex")"
    current_rgb["$color"]="$rgb"
    current_ansi8["$color"]="$(rgb_to_ansi8 $rgb)"
  done
}

hex_to_rgb() {
  local hex="${1#\#}"
  printf '%d %d %d\n' "$((16#${hex:0:2}))" "$((16#${hex:2:2}))" "$((16#${hex:4:2}))"
}

rgb_escape() {
  local r=$1
  local g=$2
  local b=$3
  printf '%s[38;2;%s;%s;%sm' "$esc" "$r" "$g" "$b"
}

ansi8_escape() {
  local code=$1
  printf '%s[38;5;%sm' "$esc" "$code"
}

rgb_to_ansi8() {
  local r=$1
  local g=$2
  local b=$3
  local rc gc bc

  if (( r == g && g == b )); then
    if (( r < 8 )); then
      printf '16\n'
      return
    fi
    if (( r > 248 )); then
      printf '231\n'
      return
    fi
    printf '%d\n' "$((232 + ((r - 8) * 24 / 247)))"
    return
  fi

  rc=$(((r * 5 + 127) / 255))
  gc=$(((g * 5 + 127) / 255))
  bc=$(((b * 5 + 127) / 255))
  printf '%d\n' "$((16 + 36 * rc + 6 * gc + bc))"
}

rgb_to_luminance() {
  local r=$1
  local g=$2
  local b=$3
  awk -v r="$r" -v g="$g" -v b="$b" 'function lin(c){c/=255; return c <= 0.04045 ? c/12.92 : ((c + 0.055) / 1.055) ^ 2.4} BEGIN { printf "%.6f\n", 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b) }'
}

rgb_to_brightness() {
  local r=$1
  local g=$2
  local b=$3
  awk -v r="$r" -v g="$g" -v b="$b" 'BEGIN { printf "%d\n", int((0.299 * r + 0.587 * g + 0.114 * b) + 0.5) }'
}

rgb_to_cmyk() {
  local r=$1
  local g=$2
  local b=$3
  awk -v r="$r" -v g="$g" -v b="$b" 'function min3(a, b, c){return a < b ? (a < c ? a : c) : (b < c ? b : c)} BEGIN { c = 1 - (r / 255); m = 1 - (g / 255); y = 1 - (b / 255); k = min3(c, m, y); if (k >= 0.999999) { printf "0 0 0 100\n"; exit } c = (c - k) / (1 - k); m = (m - k) / (1 - k); y = (y - k) / (1 - k); printf "%d %d %d %d\n", int(c * 100 + 0.5), int(m * 100 + 0.5), int(y * 100 + 0.5), int(k * 100 + 0.5) }'
}

init_cache_dir() {
  printf '%s/catppuccin' "${XDG_CACHE_HOME:-$HOME/.cache}"
}

init_cache_file() {
  local script_mtime
  script_mtime=$(stat -c '%Y' "$0" 2>/dev/null || printf '0')
  printf '%s/%s.%s.%s.init' "$(init_cache_dir)" "$prog" "$FLAVOR" "$script_mtime"
}

format_value() {
  local name=$1
  local format=$2
  local hex=$3
  local r g b ansi8

  read -r r g b <<<"$(hex_to_rgb "$hex")"
  ansi8="$(rgb_to_ansi8 "$r" "$g" "$b")"

  case "$format" in
    name) printf '%s\n' "$name" ;;
    hex) printf '%s\n' "$hex" ;;
    rgb) printf '%s %s %s\n' "$r" "$g" "$b" ;;
    rgb-r) printf '%s\n' "$r" ;;
    rgb-g) printf '%s\n' "$g" ;;
    rgb-b) printf '%s\n' "$b" ;;
    luminance) rgb_to_luminance "$r" "$g" "$b" ;;
    brightness) rgb_to_brightness "$r" "$g" "$b" ;;
    cmyk) rgb_to_cmyk "$r" "$g" "$b" ;;
    ansi-8bit|ansi-8bit-value) printf '%s\n' "$ansi8" ;;
    ansi-8bit-escapecode) ansi8_escape "$ansi8" ;;
    ansi-24bit) printf '38;2;%s;%s;%s\n' "$r" "$g" "$b" ;;
    ansi-24bit-escapecode|esc) rgb_escape "$r" "$g" "$b" ;;
    *) die "Unsupported format: $format" ;;
  esac
}

swatch() {
  local hex=$1
  local r g b
  read -r r g b <<<"$(hex_to_rgb "$hex")"
  printf '%s%s%s' "$(rgb_escape "$r" "$g" "$b")" "$block" "$rst"
}

list_colors() {
  if (( raw )); then
    printf '%s\n' "${palette[@]}"
    return
  fi

  printf '%s\n' 'Colors:'
  local name
  for name in "${palette[@]}"; do
    printf '  %s %s\n' "$(swatch "${current_palette[$name]}")" "$name"
  done
}

list_flavors() {
  if (( raw )); then
    printf '%s\n' "${flavors[@]}"
    return
  fi

  printf '%s\n' 'Flavors:'
  local flavor current=${FLAVOR}
  for flavor in "${flavors[@]}"; do
    if [[ $flavor == "$current" ]]; then
      printf '  %s%s%s%s\n' "$ansi_magenta" "$flavor" "$rst" " ${ansi_brightblack}(current)${rst}"
    elif [[ $flavor == "$default_flavor" ]]; then
      printf '  %s%s%s%s\n' "$ansi_white" "$flavor" "$rst" " ${ansi_brightblack}(default)${rst}"
    else
      printf '  %s%s%s\n' "$ansi_white" "$flavor" "$rst"
    fi
  done
}

list_formats() {
  printf '%s\n' 'Formats:'
  printf '  %s\n' "${supported_formats[@]}"
}

print_colors() {
  local format=${COLORFORMAT:-$default_format}
  local name hex value

  for name in "${palette[@]}"; do
    hex="${current_palette[$name]}"
    value="$(format_value "$name" "$format" "$hex")"
    if (( raw )); then
      if (( array )); then
        printf '%s=%q\n' "$name" "$value"
      else
        printf '%s\n' "$value"
      fi
    else
      printf '%s %-10s %s\n' "$(swatch "$hex")" "$name" "$value"
    fi
  done
}

print_all() {
  local flavor
  for flavor in "${flavors[@]}"; do
    load_flavor "$flavor" || continue
    printf '%s\n' "${bold}${flavor}${rst}"
    print_colors
    printf '\n'
  done
}

emit_shell_array() {
  local array_name=$1
  shift
  printf 'declare -gA %s=(\n' "$array_name"
  local key value
  for key in "$@"; do
    value="${current_palette[$key]}"
    printf '  [%q]=%q\n' "$key" "$value"
  done
  printf ')\n'
}

emit_shell_array_rgb() {
  local array_name=$1
  shift
  printf 'declare -gA %s=(\n' "$array_name"
  local key
  for key in "$@"; do
    printf '  [%q]=%q\n' "$key" "${current_rgb[$key]}"
  done
  printf ')\n'
}

emit_shell_array_ansi8() {
  local array_name=$1
  shift
  printf 'declare -gA %s=(\n' "$array_name"
  local key
  for key in "$@"; do
    printf '  [%q]=%q\n' "$key" "${current_ansi8[$key]}"
  done
  printf ')\n'
}

init() {
  local cache_file cache_dir
  cache_dir="$(init_cache_dir)"
  cache_file="$(init_cache_file)"

  if [[ -r "$cache_file" ]]; then
    cat "$cache_file"
    return 0
  fi

  load_flavor "$FLAVOR" || {
    err "'$FLAVOR' is not a flavor."
    list_flavors
    exit 1
  }

  mkdir -p "$cache_dir"
  {
    printf 'declare -ga catppuccin_palette=(%s)\n' "${palette[*]@Q}"
    printf 'declare -g catppuccin_flavor=%q\n' "$FLAVOR"

    local flavor color format value
    for flavor in "${flavors[@]}"; do
      load_flavor "$flavor" || continue
      for color in "${palette[@]}"; do
        if [[ $flavor == "$FLAVOR" ]]; then
          printf 'declare -gA %s=(\n' "$color"
          for format in "${supported_formats[@]}"; do
            value="$(format_value "$color" "$format" "${current_palette[$color]}")"
            printf '  [%q]=%q\n' "$format" "$value"
          done
          printf ')\n'
        fi

        printf 'declare -gA %s_%s=(\n' "$flavor" "$color"
        for format in "${supported_formats[@]}"; do
          value="$(format_value "$color" "$format" "${current_palette[$color]}")"
          printf '  [%q]=%q\n' "$format" "$value"
        done
        printf ')\n'
      done
    done
  } | tee "$cache_file"
}

main() {
  if [[ $# -eq 0 ]]; then
    usage
    exit 0
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      init|--init)
        init
        exit 0
        ;;
      -a|--array)
        raw=1
        array=1
        box=0
        shift
        ;;
      -r|--raw)
        raw=1
        box=0
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      --all)
        load_flavor "$FLAVOR" || load_flavor "$default_flavor"
        print_all
        exit 0
        ;;
      -f|--flavor)
        if [[ -n ${2:-} ]]; then
          FLAVOR=$2
          shift 2
        else
          list_flavors
          exit 0
        fi
        ;;
      mocha|macchiato|frappe|latte)
        FLAVOR=$1
        shift
        ;;
      -c|--color)
        if [[ -n ${2:-} ]]; then
          COLOR=$2
          shift 2
        else
          list_colors
          exit 0
        fi
        ;;
      rosewater|flamingo|pink|mauve|red|maroon|peach|yellow|green|teal|sky|sapphire|blue|lavender|text|subtext1|subtext0|overlay2|overlay1|overlay0|surface2|surface1|surface0|base|mantle|crust)
        COLOR=$1
        shift
        ;;
      -F|--format)
        if [[ -n ${2:-} ]]; then
          COLORFORMAT=$2
          shift 2
        else
          list_formats
          exit 0
        fi
        ;;
      esc|-e)
        COLORFORMAT='esc'
        shift
        ;;
      name|hex|rgb|rgb-r|rgb-g|rgb-b|luminance|brightness|cmyk|ansi-8bit|ansi-8bit-value|ansi-8bit-escapecode|ansi-24bit|ansi-24bit-escapecode)
        COLORFORMAT=$1
        shift
        ;;
      *)
        err "Unknown option: $1"
        exit 1
        ;;
    esac
  done

  COLORFORMAT=${COLORFORMAT:-$default_format}

  load_flavor "$FLAVOR" || {
    err "'$FLAVOR' is not a flavor."
    list_flavors
    exit 1
  }

  if [[ -n ${COLOR:-} ]]; then
    if [[ -n ${current_palette[$COLOR]+x} ]]; then
      format_value "$COLOR" "$COLORFORMAT" "${current_palette[$COLOR]}"
    else
      printf '\n'
      err "Color '$COLOR' not found in flavor '$FLAVOR'."
      printf '\n'
      list_colors
      printf '\n'
      exit 1
    fi
  else
    print_colors
  fi
}

main "$@"
