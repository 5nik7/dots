#!/usr/bin/env bash

set -u

declare -r esc=$'\033'
declare -r rst="${esc}[0m"
declare -r bold="${esc}[1m"
declare -r dim="${esc}[2m"
declare -r underline="${esc}[4m"
declare -r reverse="${esc}[7m"
declare -r ansi_black="${esc}[30m"
declare -r ansi_red="${esc}[31m"
declare -r ansi_green="${esc}[32m"
declare -r ansi_yellow="${esc}[33m"
declare -r ansi_blue="${esc}[34m"
declare -r ansi_magenta="${esc}[35m"
declare -r ansi_cyan="${esc}[36m"
declare -r ansi_white="${esc}[37m"
declare -r ansi_brightblack="${esc}[1;30m"

declare -r prog="${0##*/}"
declare -r sdir="${0%/*}"
declare -r caticon='󰄛'
declare -r block='󰄮'
declare -r default_flavor='mocha'
declare -r default_format='hex'

flavors=(mocha macchiato frappe latte)
palette=(rosewater flamingo pink mauve red maroon peach yellow green teal sky sapphire blue lavender text subtext1 subtext0 overlay2 overlay1 overlay0 surface2 surface1 surface0 base mantle crust)
supported_formats=(name hex rgb rgb-r rgb-g rgb-b luminance brightness cmyk ansi-8bit ansi-8bit-value ansi-8bit-escapecode ansi-24bit ansi-24bit-escapecode esc)

declare -A current_palette=()
declare -A current_rgb=()
declare -A current_ansi8=()

box=0
raw=0
array=0
FLAVOR=${FLAVOR:-$default_flavor}
COLOR=
COLORFORMAT=

err() { printf '%s %s %s\n' "${ansi_red}${caticon}${rst}" "${bold}[ERROR]${rst}" "$*" >&2; }
die() {
  err "$*"
  exit 1
}

logo() {
  local logo_file="${sdir}/logo"
  [[ -f "$logo_file" ]] || return 0
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done <"$logo_file"
}

usage() {
  cat <<EOF
Usage: ${prog} [options] [color]

Print Catppuccin palette values, color previews, or shell-friendly arrays.

Options
  -h, --help                  Print this message and exit
  -f, --flavor FLAVOR         Select a flavor: mocha, macchiato, frappe, latte
  -c, --color COLOR           Select a color name from the palette
  -F, --format FORMAT         Select an output format
  -r, --raw                   Print plain values instead of the preview table
  -a, --array                 Alias for --raw; emits shell assignment-friendly output
  --all                       Print every flavor in the preview table
  init, --init                Emit sourceable Bash arrays for the current flavor

Supported formats
  name, hex, rgb, rgb-r, rgb-g, rgb-b, luminance, brightness, cmyk,
  ansi-8bit, ansi-8bit-value, ansi-8bit-escapecode, ansi-24bit,
  ansi-24bit-escapecode, esc

Examples
  ${prog} mocha
  ${prog} --color blue --format rgb
  ${prog} init | source /dev/stdin
EOF
  if [[ -n ${CATPPUCCIN_SHOW_LOGO:-} ]]; then
    printf '\n'
    logo
  fi
}

mark_palette_used() {
  : "${rosewater:-}" "${flamingo:-}" "${pink:-}" "${mauve:-}" "${red:-}" "${maroon:-}" "${peach:-}" "${yellow:-}" "${green:-}" "${teal:-}" "${sky:-}" "${sapphire:-}" "${blue:-}" "${lavender:-}" "${text:-}" "${subtext1:-}" "${subtext0:-}" "${overlay2:-}" "${overlay1:-}" "${overlay0:-}" "${surface2:-}" "${surface1:-}" "${surface0:-}" "${base:-}" "${mantle:-}" "${crust:-}"
}

