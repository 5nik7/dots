+#[test]
+fn external_syntax_resolves_beside_theme_and_survives_picker_cancel() {
+    let _guard = lock_theme_test_state();
+    let original = current_theme_selection();
+    let fixture = SyntaxFixture::new();
+    let mut selected =
+        resolve_theme_selection("dots.toml", &BTreeMap::new(), Some(&fixture.0)).unwrap();
+    let mut themes = ThemeSet::load_defaults();
+    // Loading external data must not replace an existing collection entry.
+    themes.themes.insert(
+        "__leaf_external_syntax__".into(),
+        themes.themes["base16-ocean.dark"].clone(),
+    );
+    crate::theme::load_external_syntax(&mut selected, &mut themes).unwrap();
+    assert_ne!(selected.syntax_theme_name(), "__leaf_external_syntax__");
+    assert!(validate_theme_syntax(&selected, &themes).is_none());
+    set_theme_selection(selected.clone());
+    let expected = syntect::highlighting::Color {
+        r: 18,
+        g: 52,
+        b: 86,
+        a: 255,
+    };
+    assert_eq!(
+        current_syntect_theme(&themes).settings.foreground,
+        Some(expected)
+    );
+    let (ss, _) = test_assets();
+    let mut app = App::new(
+        Vec::new(),
+        Vec::new(),
+        "fixture.md".into(),
+        false,
+        false,
+        None,
+        None,
+    );
+    app.open_theme_picker();
+    app.preview_theme_preset(ThemePreset::Forest, &ss, &themes);
+    app.restore_theme_picker_preview(&ss, &themes);
+    assert_eq!(current_theme_selection(), selected);
+    assert_eq!(
+        current_syntect_theme(&themes).settings.foreground,
+        Some(expected)
+    );
+    set_theme_selection(original);
+}
