+#[test]
+fn external_syntax_embedded_absolute_and_unselected_files() {
+    let fixture = SyntaxFixture::new();
+    let mut custom = BTreeMap::new();
+    custom.insert(
+        "embedded".into(),
+        toml::from_str("syntax = 'dots.tmTheme'").unwrap(),
+    );
+    custom.insert(
+        "unused".into(),
+        toml::from_str("syntax = 'missing.tmTheme'").unwrap(),
+    );
+    let mut selected = resolve_theme_selection("embedded", &custom, Some(&fixture.0)).unwrap();
+    crate::theme::load_external_syntax(&mut selected, &mut ThemeSet::load_defaults()).unwrap();
+    let syntax_path = fixture.0.join("dots.tmTheme");
+    let source = format!("syntax = '{}'", syntax_path.display());
+    std::fs::write(fixture.0.join("dots.toml"), source).unwrap();
+    let mut selected = resolve_theme_selection("dots.toml", &custom, Some(&fixture.0)).unwrap();
+    crate::theme::load_external_syntax(&mut selected, &mut ThemeSet::load_defaults()).unwrap();
+    let mut preset = resolve_theme_selection("ocean", &custom, None).unwrap();
+    crate::theme::load_external_syntax(&mut preset, &mut ThemeSet::load_defaults()).unwrap();
+}
+
+#[test]
+fn external_syntax_missing_and_malformed_are_errors() {
+    let fixture = SyntaxFixture::new();
+    for contents in [None, Some("not a plist")] {
+        let path = fixture.0.join("dots.tmTheme");
+        if let Some(data) = contents {
+            std::fs::write(&path, data).unwrap();
+        } else {
+            std::fs::remove_file(&path).unwrap();
+        }
+        let mut selected =
+            resolve_theme_selection("dots.toml", &BTreeMap::new(), Some(&fixture.0)).unwrap();
+        let error =
+            crate::theme::load_external_syntax(&mut selected, &mut ThemeSet::load_defaults())
+                .unwrap_err();
+        assert!(error.contains("Cannot load syntax theme file"));
+    }
+}
