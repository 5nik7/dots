+#[cfg(unix)]
+#[test]
+fn external_syntax_follows_symlinks_using_logical_theme_directory() {
+    let fixture = SyntaxFixture::new();
+    let other = fixture.0.join("other");
+    std::fs::create_dir(&other).unwrap();
+    std::fs::write(other.join("source.toml"), "syntax = 'dots.tmTheme'").unwrap();
+    std::fs::remove_file(fixture.0.join("dots.toml")).unwrap();
+    std::os::unix::fs::symlink(other.join("source.toml"), fixture.0.join("dots.toml")).unwrap();
+    std::fs::rename(fixture.0.join("dots.tmTheme"), other.join("source.tmTheme")).unwrap();
+    std::os::unix::fs::symlink(other.join("source.tmTheme"), fixture.0.join("dots.tmTheme"))
+        .unwrap();
+    let mut selected =
+        resolve_theme_selection("dots.toml", &BTreeMap::new(), Some(&fixture.0)).unwrap();
+    crate::theme::load_external_syntax(&mut selected, &mut ThemeSet::load_defaults()).unwrap();
+}
