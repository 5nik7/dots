+/// Load only the selected external syntax file. Keep it in the session's theme
+/// collection so document reloads, resize and picker cancellation use it too.
+pub(crate) fn load_external_syntax(
+    selection: &mut ThemeSelection,
+    themes: &mut ThemeSet,
+) -> Result<(), String> {
+    let ThemeSelection::Custom(custom) = selection else {
+        return Ok(());
+    };
+    let Some(path) = custom.syntax_file.as_ref() else {
+        return Ok(());
+    };
+    let syntax = ThemeSet::get_theme(path).map_err(|err| {
+        format!(
+            "Cannot load syntax theme file \"{}\": {err}",
+            path.display()
+        )
+    })?;
+    let mut key = "__leaf_external_syntax__".to_string();
+    while themes.themes.contains_key(&key) {
+        key.push('_');
+    }
+    themes.themes.insert(key.clone(), syntax);
+    custom.theme.syntax_theme_name = Cow::Owned(key);
+    Ok(())
+}
