# Generated by termux-wifi-status; no runtime Android API calls.
function __termux_wifi_status_context
    set -l words (commandline -opc)
    set -l pending ''
    set -l mode root
    for word in $words[2..-1]
        if test -n "$pending"
            if test "$pending" != shell; or not string match -q -- '-*' "$word"
                set pending ''
                continue
            end
            set pending ''
        end
        switch $word
            case get -g --get '--get=*'
                set mode get
            case format -f --format '--format=*'
                set mode format
            case completion --completion '--completion=*'
                set mode completion
        end
        switch (string split -m1 = -- "$word")[1]
            case -g
                set pending field
            case --get
                set pending field
            case -f
                set pending template
            case --format
                set pending template
            case --completion
                set pending shell
            case --dir
                set pending directory
            case get
                set pending field
            case format
                set pending template
            case completion
                set pending shell
        end
        if string match -q '*=*' -- "$word"
            set pending ''
        end
    end
    set -l token (commandline -ct)
    if string match -q -- '--*=*' "$token"
        switch (string split -m1 = -- "$token")[1]
            case -g
                set pending field
            case --get
                set pending field
            case -f
                set pending template
            case --format
                set pending template
            case --completion
                set pending shell
            case --dir
                set pending directory
            case get
                set pending field
            case format
                set pending template
            case completion
                set pending shell
        end
    end
    if test "$pending" = shell; and string match -q -- '-*' "$token"
        set pending ''
    end
    if test -n "$pending"
        printf '%s\n' "$pending"
    else
        printf '%s\n' "$mode"
    end
end
complete -c termux-wifi-status -f
complete -c termux-wifi-status -n 'test (__termux_wifi_status_context) = root' -a 'get format completion'
complete -c termux-wifi-status -n 'test (__termux_wifi_status_context) = field' -a 'module state icon text age_seconds stale error connected ssid rssi level frequency_mhz link_speed_mbps'
complete -c termux-wifi-status -n 'test (__termux_wifi_status_context) = shell' -a 'bash zsh fish'
complete -c termux-wifi-status -n 'test (__termux_wifi_status_context) = directory' -a '(__fish_complete_directories)'
function __termux_wifi_status_templates
    set -l token (commandline -ct)
    set token (string replace -r '^--format=' '' -- "$token")
    set token (string replace -r "^[\"']" '' -- "$token")
    set -l prefix ''
    if string match -q '*{*' -- "$token"
        set prefix (string replace -r '\{[^{]*$' '' -- "$token")
    end
    for field in module state icon text age_seconds stale error connected ssid rssi level frequency_mhz link_speed_mbps
        printf '%s{%s}\n' "$prefix" "$field"
    end
end
complete -c termux-wifi-status -n 'test (__termux_wifi_status_context) = template' -a '(__termux_wifi_status_templates)'
complete -c termux-wifi-status -l icon -n 'contains -- (__termux_wifi_status_context) root' -d 'print a Nerd Font icon (default)'
complete -c termux-wifi-status -l text -n 'contains -- (__termux_wifi_status_context) root' -d 'print an ASCII status label'
complete -c termux-wifi-status -l both -n 'contains -- (__termux_wifi_status_context) root' -d 'print icon and text'
complete -c termux-wifi-status -l json -n 'contains -- (__termux_wifi_status_context) root' -d 'print the normalized snapshot'
complete -c termux-wifi-status -s g -l get -n 'contains -- (__termux_wifi_status_context) root field' -d 'print one field' -r -a 'module state icon text age_seconds stale error connected ssid rssi level frequency_mhz link_speed_mbps'
complete -c termux-wifi-status -s f -l format -n 'contains -- (__termux_wifi_status_context) root template' -d 'render {field} placeholders' -r -a '(__termux_wifi_status_templates)'
complete -c termux-wifi-status -l fields -n 'contains -- (__termux_wifi_status_context) root' -d 'list available fields without polling'
complete -c termux-wifi-status -l completion -n 'contains -- (__termux_wifi_status_context) root shell' -d 'print shell completion source' -a 'bash zsh fish'
complete -c termux-wifi-status -l cached -n 'contains -- (__termux_wifi_status_context) root get format' -d 'read cache without refreshing'
complete -c termux-wifi-status -l refresh -n 'contains -- (__termux_wifi_status_context) root get format' -d 'refresh now; enable successful providers'
complete -c termux-wifi-status -l no-newline -n 'contains -- (__termux_wifi_status_context) root get format' -d 'omit the final newline'
complete -c termux-wifi-status -l install -n 'contains -- (__termux_wifi_status_context) completion shell' -d 'install completion files'
complete -c termux-wifi-status -l all -n 'contains -- (__termux_wifi_status_context) completion shell' -d 'install completions for all three shells'
complete -c termux-wifi-status -l dir -n 'contains -- (__termux_wifi_status_context) completion shell' -d 'install into this exact directory' -r
complete -c termux-wifi-status -s h -l help -n 'contains -- (__termux_wifi_status_context) root get format completion shell' -d 'show help and exit'
