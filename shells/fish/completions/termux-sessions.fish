# Generated by termux-sessions; no runtime session discovery.
function __termux_sessions_context
    set -l words (commandline -opc)
    set -l pending ''
    set -l mode root
    for word in $words[2..-1]
        if test -n "$pending"
            if test "$pending" != shell; or not string match -q -- '-*' "$word"
                set pending ''
                continue
            end
            set pending ''
        end
        switch $word
            case get -g --get '--get=*'
                set mode get
            case format -f --format '--format=*'
                set mode format
            case completion --completion '--completion=*'
                set mode completion
        end
        switch (string split -m1 = -- "$word")[1]
            case -g
                set pending field
            case --get
                set pending field
            case -f
                set pending template
            case --format
                set pending template
            case --completion
                set pending shell
            case --pid
                set pending pid
            case --tty
                set pending tty
            case --dir
                set pending directory
            case get
                set pending field
            case format
                set pending template
            case completion
                set pending shell
        end
        if string match -q '*=*' -- "$word"
            set pending ''
        end
    end
    set -l token (commandline -ct)
    if string match -q -- '--*=*' "$token"
        switch (string split -m1 = -- "$token")[1]
            case -g
                set pending field
            case --get
                set pending field
            case -f
                set pending template
            case --format
                set pending template
            case --completion
                set pending shell
            case --pid
                set pending pid
            case --tty
                set pending tty
            case --dir
                set pending directory
            case get
                set pending field
            case format
                set pending template
            case completion
                set pending shell
        end
    end
    if test "$pending" = shell; and string match -q -- '-*' "$token"
        set pending ''
    end
    if test -n "$pending"
        printf '%s\n' "$pending"
    else
        printf '%s\n' "$mode"
    end
end
complete -c termux-sessions -f
complete -c termux-sessions -n 'test (__termux_sessions_context) = root' -a 'get format completion'
complete -c termux-sessions -n 'test (__termux_sessions_context) = field' -a 'current number previous next total pid tty command first last'
complete -c termux-sessions -n 'test (__termux_sessions_context) = shell' -a 'bash zsh fish'
complete -c termux-sessions -n 'test (__termux_sessions_context) = directory' -a '(__fish_complete_directories)'
function __termux_sessions_templates
    set -l token (commandline -ct)
    set token (string replace -r '^--format=' '' -- "$token")
    set token (string replace -r "^[\"']" '' -- "$token")
    set -l prefix ''
    if string match -q '*{*' -- "$token"
        set prefix (string replace -r '\{[^{]*$' '' -- "$token")
    end
    for field in current number previous next total pid tty command first last
        printf '%s{%s}\n' "$prefix" "$field"
    end
end
complete -c termux-sessions -n 'test (__termux_sessions_context) = template' -a '(__termux_sessions_templates)'
complete -c termux-sessions -l count -n 'contains -- (__termux_sessions_context) root' -d 'print the session count only'
complete -c termux-sessions -l list -n 'contains -- (__termux_sessions_context) root' -d 'list PID, TTY, and root process name'
complete -c termux-sessions -l json -n 'contains -- (__termux_sessions_context) root' -d 'print count and sessions as JSON'
complete -c termux-sessions -s g -l get -n 'contains -- (__termux_sessions_context) root field' -d 'print one session field' -r -a 'current number previous next total pid tty command first last'
complete -c termux-sessions -s f -l format -n 'contains -- (__termux_sessions_context) root template' -d 'render a template with {field} placeholders' -r -a '(__termux_sessions_templates)'
complete -c termux-sessions -l fields -n 'contains -- (__termux_sessions_context) root' -d 'print available field names'
complete -c termux-sessions -l completion -n 'contains -- (__termux_sessions_context) root shell' -d 'print shell completion source' -a 'bash zsh fish'
complete -c termux-sessions -l pid -n 'contains -- (__termux_sessions_context) root get format' -d 'resolve context from this process or its ancestors' -r
complete -c termux-sessions -l tty -n 'contains -- (__termux_sessions_context) root get format' -d 'select a Termux session by pts/N or /dev/pts/N' -r
complete -c termux-sessions -l install -n 'contains -- (__termux_sessions_context) completion shell' -d 'install completion files instead of printing source'
complete -c termux-sessions -l all -n 'contains -- (__termux_sessions_context) completion shell' -d 'install completions for all three shells'
complete -c termux-sessions -l dir -n 'contains -- (__termux_sessions_context) completion shell' -d 'install into this exact directory' -r
complete -c termux-sessions -s h -l help -n 'contains -- (__termux_sessions_context) root get format completion shell' -d 'show this help message and exit'
