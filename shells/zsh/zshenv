# Also runs for noninteractive Zsh: only paths and native platform detection.
# Resolve the source file, including file and parent-directory symlinks.
# Prompt expansion (%x) display-escapes Unicode filenames in a C locale.
# Source trace entries retain the literal filename independently of ARGZERO.
_dots_zsh_file=${${funcsourcetrace[1]%:*}:A}
if [[ ! -r $_dots_zsh_file || ! -r ${_dots_zsh_file:h}/../environment.sh || ! -r ${_dots_zsh_file:h}/../../bin/dots ]]; then
  unset _dots_zsh_file
  print -ru2 -- 'dots: Zsh startup requires a resolvable Dots checkout'
  return 1
fi
export DOTS="${_dots_zsh_file:h:h:h}"
unset _dots_zsh_file
# The linked interactive rc applies the same settings and paths from its
# prepared bundle. Login startup and independent rc files keep the early hook.
if [[ -o interactive && ! -o login && -r ${ZDOTDIR:-$HOME}/.zshrc ]]; then
  if [[ ${ZDOTDIR:-$HOME}/.zshrc -ef $DOTS/shells/zsh/zshrc ]]; then return 0; fi
  IFS= read -r _dots_rc_marker < "${ZDOTDIR:-$HOME}/.zshrc"
  if [[ $_dots_rc_marker == '# Standalone Bash/Zsh entry. The installed cold-path helper survives checkout removal.' ]]; then
    unset _dots_rc_marker
    return 0
  fi
  unset _dots_rc_marker
fi
_DOTS_STARTUP_MODE=early
source "$DOTS/lib/dots/shell/startup.bash" || { unset _DOTS_STARTUP_MODE; return 1; }
unset _DOTS_STARTUP_MODE
