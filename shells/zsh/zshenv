# Keep this entry point cheap: it also runs for noninteractive Zsh commands.
export DOTS="${DOTS:-$HOME/dots}"
prefix="${TERMUX__PREFIX:-${PREFIX:-}}"
[[ -r "$DOTS/shells/zsh/platforms/detect.zsh" ]] && source "$DOTS/shells/zsh/platforms/detect.zsh"

dotstro() { print -r -- "${distro:-unknown}"; }
is_termux() {
  [[ $1 == -v ]] && print -r -- "${is_termux:-false}"
  [[ ${is_termux:-false} == true ]]
}
is_wsl() {
  [[ $1 == -v ]] && print -r -- "${is_wsl:-false}"
  [[ ${is_wsl:-false} == true ]]
}
has_pip_pkg() {
  command -v pip &>/dev/null || return 1
  pip show "$1" -q 2>/dev/null
}
