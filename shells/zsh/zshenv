# Also runs for noninteractive Zsh: only paths and native platform detection.
# Resolve the source file, including file and parent-directory symlinks.
# Prompt expansion (%x) display-escapes Unicode filenames in a C locale.
# Source trace entries retain the literal filename independently of ARGZERO.
_dots_zsh_file=${${funcsourcetrace[1]%:*}:A}
if [[ ! -r $_dots_zsh_file || ! -r ${_dots_zsh_file:h}/../environment.sh || ! -r ${_dots_zsh_file:h}/../../bin/dots ]]; then
  unset _dots_zsh_file
  print -ru2 -- 'dots: Zsh startup requires a resolvable Dots checkout'
  return 1
fi
export DOTS="${_dots_zsh_file:h:h:h}"
unset _dots_zsh_file
source "$DOTS/shells/environment.sh" || return
prefix="${TERMUX__PREFIX:-${PREFIX:-}}"
[[ -r "$DOTS/shells/zsh/platforms/detect.zsh" ]] && source "$DOTS/shells/zsh/platforms/detect.zsh"
