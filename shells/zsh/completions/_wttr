#compdef wttr
# Generated by wttr; no weather calls.
_wttr() {
  local context state state_descr line
  typeset -A opt_args
  if [[ $words[2] == completion ]]; then
    _arguments '--all[All shells]' '--install[Install with backup]' '--dir[Destination]:directory:_files -/' '*:shell:(bash zsh fish powershell)'
  else
    _arguments -s \
  '--location[Override configured location or automatic city]:value:' \
  '--current[Show current conditions only]' \
  '--days[Number of forecast days (default: 3)]:value:(1 2 3)' \
  '--hourly[Include three-hourly forecast rows]' \
  '--units[Temperature, wind and precipitation units]:value:(us metric)' \
  '--language[Weather description language (default: en)]:value:' \
  '--widget[Print a compact cached widget; refresh in background]' \
  '--format[Widget template with literal {field} placeholders]:value:' \
  '--get[Print one field; also: wttr get FIELD]:value:(location attribution condition code icon temperature unit feels_like humidity wind wind_unit wind_direction precipitation precipitation_unit sunrise sunset daylight age stale stale_marker)' \
  '--fields[List available template and scalar fields]' \
  '--json[Print the original wttr.in j1 object]' \
  '--daylight[Print day, night or unknown; refresh in background]' \
  '--refresh[Refresh now, overriding freshness and cooldown]' \
  '--cached[Read only; never spawn, locate, lock or write]' \
  '--allow-stale[Allow marked weather up to max_stale age]' \
  '--config[Use this TOML configuration file]:value:_files' \
  '--timeout[Total refresh deadline (1–60 seconds)]:value:' \
  '--color[Human and widget output colors]:value:(auto always never)' \
  '--icons[Weather icons (widget auto uses icons)]:value:(auto always never)' \
  '--verbose[Show cache provenance and age in human output]' \
  '--help[Show usage without querying providers]' \
  '--version[Print version]' \
  '*:argument:->argument'
    if [[ $state == argument ]]; then
      if [[ $words[2] == get ]]; then
        compadd -- location attribution condition code icon temperature unit feels_like humidity wind wind_unit wind_direction precipitation precipitation_unit sunrise sunset daylight age stale stale_marker
      else
        local -a stock_options
        stock_options=('m:Metric (SI) units' 'u:US customary units' 'M:Wind speed in meters per second' '0:Current weather only' '1:Current weather and today forecast' '2:Current weather, today and tomorrow forecasts' 'A:Ignore User-Agent and force ANSI terminal output' 'd:Restrict output to standard console font glyphs' 'F:Hide the Follow line' 'n:Narrow view with only day and night' 'q:Quiet\: hide the Weather report heading' 'Q:Superquiet\: hide heading and city name' 'T:Disable terminal sequences and colors' 'format=:Upstream format preset or percent template' 'moon:Current Moon phase' 'moon@:Moon phase for YYYY-MM-DD' '\:help:Show upstream usage' '\:bash.function:Show the recommended Bash function' '\:translation:Show translation and contributor information' 'get:Query a weather field' 'completion:Generate or install completions')
        _describe -t wttr-stock-options 'wttr.in options' stock_options
      fi
    fi
  fi
}
_wttr "$@"
