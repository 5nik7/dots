#compdef battery
# Generated by battery --completion zsh
    local -a fields
    fields=(
        present technology health health_state plugged plug plug_icon status state
        temperature temp_c voltage voltage_v current current_ma current_average
        current_average_ma percentage percent level scale charge_counter cycle icon
    )

    _arguments -s -S \
        '(-h --help)'{-h,--help}'[show help]' \
        '(-V --version)'{-V,--version}'[show version]' \
        '(-d --debug)'{-d,--debug}'[print debug information to stderr]' \
        '--trace[enable Bash execution tracing]' \
        '(-s --style --text --icon --both)'{-s,--style}'[select percentage display style]:style:(text icon both)' \
        '(-s --style --text --icon --both)--text[show percentage as text]' \
        '(-s --style --text --icon --both)--icon[show only a Nerd Font icon]' \
        '(-s --style --text --icon --both)--both[show icon and percentage text]' \
        '--plugged[append power source or unplugged state]' \
        '--no-plugged[do not append power source information]' \
        '--status[append battery status]' \
        '--no-status[do not append battery status]' \
        '--health[append battery health]' \
        '--no-health[do not append battery health]' \
        '--temperature[append temperature in degrees Celsius]' \
        '--no-temperature[do not append battery temperature]' \
        '(-f --format -g --get -j --json)'{-f,--format}'[render a custom format]:format string:' \
        '(-f --format -g --get -j --json)'{-g,--get}'[print one field without color]:field:($fields)' \
        '(-f --format -g --get -j --json)'{-j,--json}'[print original Termux API JSON]' \
        '(-n --no-newline)'{-n,--no-newline}'[omit the final newline]' \
        '--newline[append the normal final newline]' \
        '-c[force ANSI color]' \
        '--color=[select when color is emitted]:mode:(auto always never)' \
        '--no-color[disable ANSI color]' \
        '--color-by=[choose the value that controls color]:mode:(percentage status health none)' \
        '--critical=[set red percentage ceiling]:percentage (0-100):' \
        '--low=[set yellow percentage ceiling]:percentage (0-100):' \
        '--backend=[select API backend]:backend:(auto direct wrapper)' \
        '--config=[read defaults from a config file]:config file:_files' \
        '--no-config[do not read a configuration file]' \
        '--config-path[print the resolved configuration path]' \
        '--list-fields[list available fields and placeholders]' \
        '(-C --completion)'{-C,--completion}'[generate shell completion code]:shell:(bash zsh fish)'

