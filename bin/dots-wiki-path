#!/usr/bin/env bash
# dots:summary=Print a wiki checkout or page path
# dots:usage=[PAGE] [--source]
# dots:option=--source||flag|Print the canonical source path
# dots:argument=1|wiki-page|Wiki page ID
WIKI_LIB=$(cd -- "${BASH_SOURCE[0]%/*}/../lib/dots" && pwd) || exit
exec python3 -B "$WIKI_LIB/wiki.py" path "$@"
