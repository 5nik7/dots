#!/usr/bin/env bash
# dots:summary=Inspect generated theme files and application connections
# dots:usage=[list|info|show|path|check|browse] [ARGS]
# dots:option=--app||theme-app|Filter the default listing by application
# dots:option=--json||flag|Emit the default listing as versioned JSON
root=$(cd -- "${BASH_SOURCE[0]%/*}/.." && pwd) || exit
export DOTS=${DOTS:-$root}
source "$root/lib/dots/shell/config.bash"
_dots_config_load || exit
export DOTS_COLOR=${DOTS_COLOR:-${dots_options[DOTS_COLOR]:-auto}}
export DOTS_ICONS=${DOTS_ICONS:-${dots_options[DOTS_ICONS]:-auto}}
exec python3 -B "$root/lib/dots/themes/inspection.py" "$@"
