#!/usr/bin/env bash
# dots:summary=Inspect theme plugins without executing hooks
# dots:usage=[NAME] [--json]
# dots:argument=1|theme-plugin|Plugin name
# dots:option=--json||flag|Emit versioned JSON
PLUGIN_LIB=$(cd -- "${BASH_SOURCE[0]%/*}/../lib/dots/themes" && pwd) || exit
exec python3 -B "$PLUGIN_LIB/plugins.py" doctor "$@"
