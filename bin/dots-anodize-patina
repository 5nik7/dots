# dots:option=--yes||flag|Save without prompting
# dots:argument=1|file|Input file
# dots:option=--logo||choice:text,auto,kitty,chafa|Logo renderer (default: text)
# dots:option=--logo-layout||choice:auto,base,horizontal,stacked,icon|Logo layout; base selects LOGO1
ANODIZE_LIB=$(cd -- "${BASH_SOURCE[0]%/*}/../plugins/anodize" && pwd) || exit
exec python3 -B "$ANODIZE_LIB/cli.py" patina "$@"
