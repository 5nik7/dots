#!/usr/bin/env bash
# dots:summary=Regenerate the selected theme
# dots:usage=[--commands-only]
# dots:option=--commands-only||flag|Rebuild theme commands without activating a palette
DT_LIB=$(cd -- "${BASH_SOURCE[0]%/*}/../lib/dots/themes" && pwd) || exit
set -- refresh "$@"
source "$DT_LIB/commands.bash"
