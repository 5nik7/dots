#!/usr/bin/env bash
# dots:summary=Validate all profile definitions
# dots:usage=[OPTIONS]
# dots:option=--json||flag|Print versioned JSON
# dots:option=--verbose|-v|flag|Show additional resolution evidence
DOTS=${DOTS:-$(cd -- "${BASH_SOURCE[0]%/*}/.." && pwd -P)}
exec python3 -B "$DOTS/lib/dots/profiles.py" profiles check "$@"
