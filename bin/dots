#!/usr/bin/env bash
# A small entry point; catalog and presentation are loaded only when requested.
set -o pipefail
if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4) )); then
  printf 'dots requires Bash 4.4 or newer\n' >&2
  exit 1
fi

_dots_source=${BASH_SOURCE[0]}
[[ $_dots_source == /* ]] || _dots_source=$PWD/$_dots_source
_dots_links=0
while [[ -L $_dots_source ]]; do
  (( ++_dots_links <= 40 )) || { printf 'dots: executable symlink loop\n' >&2; exit 1; }
  _dots_target=$(readlink -- "$_dots_source") || exit 1
  if [[ $_dots_target == /* ]]; then _dots_source=$_dots_target
  else _dots_source=${_dots_source%/*}/$_dots_target; fi
done
DOTS_LIB_DIR=${_dots_source%/*}/../lib/dots
if [[ -z ${DOTS:-} ]]; then
  DOTS=$(cd -- "${_dots_source%/*}/.." && pwd -P) || exit 1
fi
export DOTS DOTS_LIB_DIR
# shellcheck source=lib/dots/dispatch.bash
source "$DOTS_LIB_DIR/dispatch.bash"
dots_main "$@"
