#!/usr/bin/env bash
# dots:summary=Inspect an authored theme
# dots:usage=ID [OPTIONS]
# dots:option=--json||flag|Emit versioned JSON
# dots:argument=1|theme-id|Theme identifier
# dots:option=--logo||choice:text,auto,kitty,chafa|Logo renderer (default: text)
# dots:option=--logo-layout||choice:auto,horizontal,stacked,icon|Logo layout, bounded to fit
ANODIZE_LIB=$(cd -- "${BASH_SOURCE[0]%/*}/../lib/dots/anodize" && pwd) || exit
exec python3 -B "$ANODIZE_LIB/cli.py" show "$@"
