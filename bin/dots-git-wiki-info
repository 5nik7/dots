#!/usr/bin/env bash
# dots:summary=Inspect only the wiki repository
# dots:usage=[OPTIONS]
# dots:option=--directory|-C|directory|Repository or subtree directory
# dots:option=--json||flag|Emit versioned JSON
# dots:option=--full-paths||flag|Show absolute human paths
# dots:option=--view||choice:default,short,verbose|Select the human output view
# dots:option=--short|-s|flag|Use compact human output
# dots:option=--verbose|-v|flag|Show metadata and action details without patches
WIKI_LIB=$(cd -- "${BASH_SOURCE[0]%/*}/../lib/dots" && pwd) || exit
exec python3 -B "$WIKI_LIB/wiki_git.py" info "$@"
