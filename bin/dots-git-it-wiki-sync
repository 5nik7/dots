#!/usr/bin/env bash
# dots:summary=Synchronize only the wiki repository
# dots:usage=[OPTIONS]
# dots:option=--directory|-C|directory|Repository or subtree directory
# dots:option=--json||flag|Emit versioned JSON
# dots:option=--full-paths||flag|Show absolute human paths
# dots:option=--view||choice:default,short,verbose|Select the human output view
# dots:option=--short|-s|flag|Use compact human output
# dots:option=--verbose|-v|flag|Show metadata and action details without patches
# dots:option=--dry-run||flag|Local preview without changes or network
# dots:option=--remote||flag|Advance to configured submodule branches
# dots:option=--init||flag|Permit initializing missing submodules
# dots:option=--color||choice:auto,always,never|Select terminal colors
# dots:option=--no-color||flag|Disable terminal colors
# dots:option=--no-progress||flag|Disable terminal progress
exec "${BASH_SOURCE[0]%/*}/dots-git-it" wiki sync "$@"
