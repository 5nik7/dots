#!/usr/bin/env bash
# dots:summary=Set a wallpaper image
# dots:usage=FILE [--lock-screen]
# dots:argument=1|file|Background image
# dots:option=--lock-screen||flag|Set the Android lock-screen wallpaper
DT_LIB=$(cd -- "${BASH_SOURCE[0]%/*}/../lib/dots/themes" && pwd) || exit
set -- bg set "$@"
source "$DT_LIB/commands.bash"
