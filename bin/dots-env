#!/usr/bin/env bash
# shellcheck disable=SC2034,SC2154
# dots:summary=Inspect resolved Dots settings and paths
# dots:usage=[NAME] [--json]
# dots:argument=1|dots-setting|Dots setting or derived value
# dots:option=--json||flag|Print values with provenance as JSON
DOTS=${DOTS:-$(cd -- "${BASH_SOURCE[0]%/*}/.." && pwd -P)}
source "$DOTS/lib/dots/shell/config.bash"
_dots_config_load || exit
declare -A values=() origins=()
while IFS=$'\t' read -r key kind value description; do
  values[$key]=${dots_options[$key]} origins[$key]=${dots_option_sources[$key]}
done < "$DOTS/lib/dots/shell/settings.tsv"
while IFS=$'\t' read -r key field relative; do
  [[ $key != - ]] || continue
  values[$key]=$DOTS
  [[ $relative == . ]] || values[$key]=$DOTS/$relative
  origins[$key]=checkout
done < "$DOTS/lib/dots/shell/paths.tsv"
values[DOTS_CONFIG_FILE]=$_DOTS_CONFIG_PATH origins[DOTS_CONFIG_FILE]=resolved
values[DOTS_STATE_DIR]=${XDG_STATE_HOME:-$HOME/.local/state}/dots origins[DOTS_STATE_DIR]=resolved
values[DOTS_THEME_ID]=${DOTS_THEME_SELECTION:-${dots_options[DOTS_THEME_DEFAULT]}}
origins[DOTS_THEME_ID]=default
if [[ -n ${DOTS_THEME_SELECTION:-} ]]; then origins[DOTS_THEME_ID]=environment
elif [[ -r ${values[DOTS_STATE_DIR]}/current/theme/id ]]; then
  IFS= read -r 'values[DOTS_THEME_ID]' < "${values[DOTS_STATE_DIR]}/current/theme/id"
  origins[DOTS_THEME_ID]=published
fi
json=0 name=''
for argument; do
  case $argument in --json) json=1 ;; -*) exit 2 ;; *) [[ ! $name ]] || exit 2; name=$argument ;; esac
done
[[ ! $name || -n ${origins[$name]:-} ]] || { printf 'dots env: unknown name\n' >&2; exit 2; }
quote() {
  local text=$1 character code i
  printf '"'
  for ((i=0;i<${#text};i++)); do
    character=${text:i:1}
    case $character in
      '"') printf '\\"' ;; '\') printf '\\\\' ;;
      *) printf -v code '%d' "'$character"
         if ((code < 32)); then printf '\\u%04x' "$code"; else printf '%s' "$character"; fi ;;
    esac
  done
  printf '"'
}
# Stable schema order, followed by derived fields; no whole-environment dump.
keys=()
while IFS=$'\t' read -r key kind value description; do keys+=("$key"); done < "$DOTS/lib/dots/shell/settings.tsv"
while IFS=$'\t' read -r key field relative; do [[ $key == - ]] || keys+=("$key"); done < "$DOTS/lib/dots/shell/paths.tsv"
keys+=(DOTS_CONFIG_FILE DOTS_STATE_DIR DOTS_THEME_ID)
[[ ! $name ]] || keys=("$name")
if ((json)); then
  printf '{"version":1,"values":{'; separator=''
  for key in "${keys[@]}"; do
    printf '%s' "$separator"; quote "$key"; printf ':{"value":'; quote "${values[$key]}"
    printf ',"source":'; quote "${origins[$key]}"; printf '}'; separator=,
  done
  printf '}}\n'
elif [[ $name ]]; then printf '%s\n' "${values[$name]}"
else
  for key in "${keys[@]}"; do printf '%s=%s [%s]\n' "$key" "${values[$key]}" "${origins[$key]}"; done
fi
