#!/usr/bin/env bash
# dots:summary=Browse and edit configuration in a popup or terminal
# dots:usage=[OPTIONS]
# dots:option=--defaults||flag|Use shared color and icon defaults
# dots:option=--profile||profile-id|Select a profile without activating it
# dots:option=--query||string|Initial browser search
# dots:option=--client||string|Initiating tmux client
# dots:option=--json||flag|Print structured configuration without browsing
# dots:example=dots config browse --query icons
# dots:example=dots config browse --profile windows
DOTS=${DOTS:-$(cd -- "${BASH_SOURCE[0]%/*}/.." && pwd -P)}
exec python3 -B "$DOTS/lib/dots/config_cli.py" browse "$@"
