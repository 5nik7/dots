#!/usr/bin/env bash
# dots:summary=Create or edit source and destination mappings with optional live apply
# dots:option=--verbose|-v|flag|Show actions, backups and unchanged/skipped reasons
# dots:usage=[RESOURCE | --new] [OPTIONS]
# dots:option=--pick||flag|Select interactively; combine with --dry-run to preview
# dots:option=--new||flag|Create an explicit new catalog mapping
# dots:option=--repo||file-repository|Owning repository for a new mapping
# dots:option=--id||string|Stable ID for a new mapping
# dots:option=--source||string|Source relative to the owning repository
# dots:option=--target||string|Portable target template or home/XDG path
# dots:option=--app||string|Application for a new mapping
# dots:option=--category||string|Category for a new mapping
# dots:option=--strategy||choice:link,directory-link,copy|Source strategy; live copy is unsupported
# dots:option=--platform||choice:termux,linux,wsl,windows|Edit this platform's base profile (default: active profile)
# dots:option=--platforms||string|Resource eligibility in the core registry
# dots:option=--apply||flag|Also reconcile live links on this platform
# dots:option=--dry-run||flag|Preview without changes; --pick explicitly selects
# dots:option=--yes||flag|Apply without prompting; requires explicit selection and fields
# dots:option=--json||flag|Emit versioned JSON; requires --yes or --dry-run
# dots:option=--backup||flag|Approve occupied replacements during live apply
# dots:option=--no-backup||flag|Refuse occupied replacements; retain required recovery data
# dots:argument=1|file-resource|Qualified resource ID
FILES_LIB=$(cd -- "${BASH_SOURCE[0]%/*}/../lib/dots/files" && pwd) || exit
exec python3 -B "$FILES_LIB/mappings.py" edit "$@"
