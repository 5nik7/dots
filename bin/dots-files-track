#!/usr/bin/env bash
# dots:summary=Record file ownership and destination metadata
# dots:usage=SOURCE [OPTIONS]
# dots:option=--json||flag|Emit versioned JSON
# dots:option=--all-platforms||flag|Include inactive platforms
# dots:option=--repo||file-repository|Repository ID
# dots:option=--id||string|Stable resource ID
# dots:option=--app||string|Application
# dots:option=--category||string|Category
# dots:option=--target||string|Literal target template
# dots:option=--platforms||string|Applicable platforms
# dots:option=--strategy||choice:link,copy,directory-link|link, copy or directory-link
# dots:option=--replaces||string|Qualified resource replaced
# dots:option=--update||flag|Update an existing record
FILES_LIB=$(cd -- "${BASH_SOURCE[0]%/*}/../lib/dots/files" && pwd) || exit
exec python3 -B "$FILES_LIB/catalog.py" track "$@"
