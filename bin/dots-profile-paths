#!/usr/bin/env bash
# dots:summary=Inspect profile directories and PATH contributions
# dots:usage=[ID] [OPTIONS]
# dots:option=--json||flag|Print versioned JSON
# dots:option=--verbose|-v|flag|Show additional resolution evidence
# dots:option=--kind||choice:config,bin,scripts,lib,shells,docs,skills,path|Select directory kind
# dots:option=--existing||flag|Only existing directories
# dots:option=--raw||flag|Emit absolute paths; requires --kind
# dots:argument=1|profile-id|Profile ID; defaults to the current profile
DOTS=${DOTS:-$(cd -- "${BASH_SOURCE[0]%/*}/.." && pwd -P)}
exec python3 -B "$DOTS/lib/dots/profiles.py" profile paths "$@"
