#!/usr/bin/env bash
# dots:summary=Read current source pages or focused topic sections
# dots:usage=[--query QUERY]
# dots:option=--query||string|Find ranked source topics before choosing
WIKI_LIB=$(cd -- "${BASH_SOURCE[0]%/*}/../lib/dots" && pwd) || exit
exec python3 -B "$WIKI_LIB/wiki.py" browse "$@"
