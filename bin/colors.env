#!/usr/bin/env bash

declare ESC=$'\x1b'
declare RST=$'\x1b[0m'
declare rst=$'\x1b[0m'

color_array() {
  declare -xgA COLOR
  local ESC=$'\x1b'
  local i
  for i in {0..255}; do
	COLOR[$i]="${ESC}[38;5;${i}mcolor $i"
  ((j++))
	done
}

fg_array() {
  declare -xgA FG
  local ESC=$'\x1b'
  local i
	for i in {0..255}; do
	FG[$i]="${ESC}[38;5;${i}m"
  ((j++))
	done
}

bg_array() {
  declare -xgA BG
  local ESC=$'\x1b'
  local i
	for i in {0..255}; do
	BG[$i]="${ESC}[48;5;${i}m"
  ((j++))
	done
}

build_color_arrays() {
  color_array;
  fg_array;
  bg_array;
}

build_color_arrays

ROSEWATER="${ESC}[38;5;224m"
FLAMINGO="${ESC}[38;5;224m"
PINK="${ESC}[38;5;225m"
MAUVE="${ESC}[38;5;183m"
RED="${ESC}[38;5;211m"
MAROON="${ESC}[38;5;217m"
PEACH="${ESC}[38;5;216m"
YELLOW="${ESC}[38;5;222m"
GREEN="${ESC}[38;5;114m"
TEAL="${ESC}[38;5;116m"
SKY="${ESC}[38;5;116m"
SAPPHIRE="${ESC}[38;5;81m"
BLUE="${ESC}[38;5;111m"
LAVENDER="${ESC}[38;5;147m"
TEXT="${ESC}[38;5;189m"
SUBTEXT1="${ESC}[38;5;146m"
SUBTEXT0="${ESC}[38;5;146m"
OVERLAY2="${ESC}[38;5;103m"
OVERLAY1="${ESC}[38;5;103m"
OVERLAY0="${ESC}[38;5;60m"
SURFACE2="${ESC}[38;5;60m"
SURFACE0="${ESC}[38;5;235m"
BASE="${ESC}[38;5;234m"
MANTLE="${ESC}[38;5;233m"
CRUST="${ESC}[38;5;232m"

if [[ -n ${ZSH_VERSION:-} ]] && zmodload zsh/terminfo 2>/dev/null; then
  typeset -g BOLD="${terminfo[bold]:-}"
  typeset -g UNDERLINE="${terminfo[smul]:-}"
  typeset -g ITALIC="${terminfo[sitm]:-}"
  typeset -g DIM="${terminfo[dim]:-}"
  typeset -g INVERT="${terminfo[rev]:-}"
  typeset -g BLINK="${terminfo[blink]:-}"
  typeset -g INVIS="${terminfo[invis]:-}"
  typeset -g rst="${terminfo[sgr0]:-}"
  local _dots_color_index
  local -a _dots_color_names=(BLACK RED GREEN YELLOW BLUE MAGENTA CYAN GREY BRIGHTBLACK BRIGHTRED BRIGHTGREEN BRIGHTYELLOW BRIGHTBLUE BRIGHTMAGENTA BRIGHTCYAN WHITE)
  for _dots_color_index in {1..16}; do
    typeset -g "${_dots_color_names[$_dots_color_index]}=$(echoti setaf $((_dots_color_index - 1)) 2>/dev/null)"
  done
else
declare BOLD="$(tput bold 2>/dev/null || printf '')"
declare UNDERLINE="$(tput smul 2>/dev/null || printf '')"
declare ITALIC="$(tput sitm 2>/dev/null || printf '')"
declare DIM="$(tput dim 2>/dev/null || printf '')"
declare INVERT="$(tput rev 2>/dev/null || printf '')"
declare BLINK="$(tput blink 2>/dev/null || printf '')"
declare INVIS="$(tput invis 2>/dev/null || printf '')"
declare BLACK="$(tput setaf 0 2>/dev/null || printf '')"
declare RED="$(tput setaf 1 2>/dev/null || printf '')"
declare GREEN="$(tput setaf 2 2>/dev/null || printf '')"
declare YELLOW="$(tput setaf 3 2>/dev/null || printf '')"
declare BLUE="$(tput setaf 4 2>/dev/null || printf '')"
declare MAGENTA="$(tput setaf 5 2>/dev/null || printf '')"
declare CYAN="$(tput setaf 6 2>/dev/null || printf '')"
declare GREY="$(tput setaf 7 2>/dev/null || printf '')"
declare BRIGHTBLACK="$(tput setaf 8 2>/dev/null || printf '')"
declare BRIGHTRED="$(tput setaf 9 2>/dev/null || printf '')"
declare BRIGHTGREEN="$(tput setaf 10 2>/dev/null || printf '')"
declare BRIGHTYELLOW="$(tput setaf 11 2>/dev/null || printf '')"
declare BRIGHTBLUE="$(tput setaf 12 2>/dev/null || printf '')"
declare BRIGHTMAGENTA="$(tput setaf 13 2>/dev/null || printf '')"
declare BRIGHTCYAN="$(tput setaf 14 2>/dev/null || printf '')"
declare WHITE="$(tput setaf 15 2>/dev/null || printf '')"
declare rst="$(tput sgr0 2>/dev/null || printf '')"
fi
