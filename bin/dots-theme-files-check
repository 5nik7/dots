#!/usr/bin/env bash
# dots:summary=Check generated artifacts and theme connections without changes
# dots:usage=[--app APP] [--consumers] [--json]
# dots:option=--app||theme-app|Filter by application
# dots:option=--consumers||flag|Also fail on confirmed consumer differences
# dots:option=--json||flag|Emit versioned JSON
root=$(cd -- "${BASH_SOURCE[0]%/*}/.." && pwd) || exit
export DOTS=${DOTS:-$root}
source "$root/lib/dots/shell/config.bash"
_dots_config_load || exit
export DOTS_COLOR=${DOTS_COLOR:-${dots_options[DOTS_COLOR]:-auto}}
export DOTS_ICONS=${DOTS_ICONS:-${dots_options[DOTS_ICONS]:-auto}}
exec python3 -B "$root/lib/dots/themes/inspection.py" check "$@"
