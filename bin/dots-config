#!/usr/bin/env bash
# dots:summary=Browse and edit shared preferences or explicit profile overrides
# dots:usage=[SUBCOMMAND] [OPTIONS]
# dots:option=--defaults||flag|Use shared preference defaults
# dots:option=--profile||profile-id|Select a profile without activating it
# dots:option=--json||flag|Print structured configuration data
# dots:option=--query||string|Initial browser search
# dots:option=--client||string|Initiating tmux client for browsing
DOTS=${DOTS:-$(cd -- "${BASH_SOURCE[0]%/*}/.." && pwd -P)}
exec python3 -B "$DOTS/lib/dots/config_cli.py" "$@"
