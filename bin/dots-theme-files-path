#!/usr/bin/env bash
# dots:summary=Print an exact generated theme file or source path
# dots:usage=[FILE] [--source|--resolved]
# dots:argument=1|theme-file|Generated file identifier
# dots:option=--source||flag|Locate the source for next refresh
# dots:option=--resolved||flag|Locate the captured generation
root=$(cd -- "${BASH_SOURCE[0]%/*}/.." && pwd) || exit
export DOTS=${DOTS:-$root}
source "$root/lib/dots/shell/config.bash"
_dots_config_load || exit
export DOTS_COLOR=${DOTS_COLOR:-${dots_options[DOTS_COLOR]:-auto}}
export DOTS_ICONS=${DOTS_ICONS:-${dots_options[DOTS_ICONS]:-auto}}
exec python3 -B "$root/lib/dots/themes/inspection.py" path "$@"
