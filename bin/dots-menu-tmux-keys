#!/usr/bin/env bash
# dots:summary=Browse readable live tmux keybindings with FZF
# dots:usage=[--print|--json|--browse] [OPTIONS]
# dots:option=--print||flag|Print without opening FZF
# dots:option=--json||flag|Print versioned binding data
# dots:option=--browse||flag|Open FZF explicitly, including from a tmux binding
# dots:option=--query||string|Initial search text
# dots:option=--mode||string|Starting picker table or exact print/JSON table filter
# dots:example=dots menu tmux keys
DOTS=${DOTS:-$(cd -- "${BASH_SOURCE[0]%/*}/.." && pwd -P)}
exec python3 -B "$DOTS/lib/dots/keys_cli.py" tmux "$@"
